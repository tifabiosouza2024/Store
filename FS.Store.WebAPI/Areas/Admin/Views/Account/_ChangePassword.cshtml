@model ChangePasswordViewModel

<form id="changePasswordForm" method="post">
    <div class="account-section-header mb-4">
        <h6 class="mb-1">Alterar senha</h6>
        <p class="text-muted small mb-0">Atualize sua senha para manter sua conta protegida.</p>
    </div>

    <div class="account-password-form">
        <div class="row g-3">

            <div class="col-md-6 col-sm-12">
                <label asp-for="NewPassword" class="form-label">Nova senha</label>
                <div class="input-group">
                    <input type="password" asp-for="NewPassword" class="form-control" placeholder="Digite sua nova senha" autocomplete="new-password" required />
                    <button class="btn btn-outline-secondary account-toggle-password" type="button" data-target="NewPassword" aria-label="Mostrar senha" tabindex="-1">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small d-block mt-1"></span>
                <div class="account-password-strength mt-2">
                    <div class="progress" style="height: 5px;">
                        <div class="progress-bar" id="passwordStrengthBar" role="progressbar" aria-valuemin="0" aria-valuemax="5" aria-valuenow="0"></div>
                    </div>
                    <small class="text-muted" id="passwordStrengthText">Informe sua nova senha.</small>
                </div>
            </div>
            <div class="col-md-6 col-sm-12">
                <label asp-for="ConfirmPassword" class="form-label">Confirmar nova senha</label>
                <div class="input-group">
                    <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Repita sua nova senha" autocomplete="new-password" required />
                    <button class="btn btn-outline-secondary account-toggle-password" type="button" data-target="ConfirmPassword" aria-label="Mostrar senha" tabindex="-1">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mt-1"></span>
                <small class="text-muted d-block mt-2" id="passwordMatchText" aria-live="polite"></small>
            </div>

            <div class="account-password-tips mt-4 p-3 rounded">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-shield-check"></i>
                    <strong class="small">Recomendações para sua senha</strong>
                </div>
                <ul class="small text-muted mb-0 ps-4">
                    <li>Utilize pelo menos 8 caracteres.</li>
                    <li>Combine letras maiúsculas e minúsculas.</li>
                    <li>Inclua números e caracteres especiais.</li>
                    <li>Evite utilizar informações pessoais.</li>
                </ul>
            </div>
            <div class="col-12">
                <hr class="my-2" />
            </div>
            <div class="col-md-7 col-lg-6 col-sm-12">
                <label asp-for="CurrentPassword" class="form-label">Senha atual</label>
                <div class="input-group">
                    <input type="password" asp-for="CurrentPassword" class="form-control" placeholder="Digite sua senha atual" autocomplete="current-password" required />
                    <button class="btn btn-outline-secondary account-toggle-password" type="button" data-target="CurrentPassword" aria-label="Mostrar senha" tabindex="-1">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="CurrentPassword" class="text-danger small d-block mt-1"></span>
            </div>
        </div>

        <div class="account-form-actions mt-4 pt-3 border-top">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-shield-check me-1"></i>
                Alterar senha
            </button>
        </div>
    </div>
</form>
