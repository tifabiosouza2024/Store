@{
    ViewData["Title"] = "Alteração de senha";
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin/change-password.css" asp-append-version="true" />
}

<div class="container-fluid account-page">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="mb-1">Alteração de senha</h4>
        </div>
    </div>
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="account-header d-flex align-items-center gap-3 mb-4">
                <div class="account-avatar">
                    <i class="bi bi-exclamation-circle-fill"></i>
                </div>
                <div>
                    <span class="text-muted small">Alteração de senha necessária.</span>
                </div>
            </div>
            <partial name="_ChangePassword" />
        </div>
    </div>

</div>

@section Scripts {
    <script type="text/javascript" src="~/js/admin/change-password.js" asp-append-version="true"></script>
}