@model PaymentTerminalIndexViewModel

@{
    ViewData["Title"] = "Lista de Terminais";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Terminais de Pagamento</h2>
            <p class="text-muted mb-0">
                Gerencie os terminais de pagamento da operação.
            </p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model.PaymentTerminals?.Any() == true)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Nome do terminal</th>
                                <th>Fornecedor</th>
                                <th class="text-end" style="width: 150px;">
                                    Ações
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var terminal in Model.PaymentTerminals)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">
                                            @terminal.Name
                                        </span>
                                    </td>

                                    <td>
                                        @(terminal.PaymentProvider?.Name ?? "Não informado")
                                    </td>

                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit"                                               asp-route-id="@terminal.Id"                                               class="btn btn-outline-primary"                                               title="Editar terminal"                                               aria-label="Editar terminal">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <a asp-action="Delete"                                               asp-route-id="@terminal.Id"                                               class="btn btn-outline-danger"                                               title="Excluir terminal"                                               aria-label="Excluir terminal">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-credit-card display-4 text-muted"></i>

                    <h5 class="mt-3">Nenhum terminal cadastrado</h5>

                    <p class="text-muted">
                        Cadastre um terminal para começar a utilizá-lo.
                    </p>
                </div>
            }
        </div>
    </div>
</div>

@{
    var fab = new FloatingButtonDto
    {
        MainUrl = "/Admin/PaymentTerminal/Create"
    };
}

<partial name="_FloatingButtons" model="fab" />
