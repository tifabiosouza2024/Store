@model PaymentTerminalCreateViewModel

@{
    ViewData["Title"] = "Cadastrar Terminal";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="mb-1">Cadastrar Terminal</h2>
        <p class="text-muted mb-0">
            Informe os dados do terminal de pagamento para <b>@Model.OperationName</b>
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 col-lg-4 mb-3">
                        <label asp-for="Name" class="form-label">
                            Nome do terminal
                        </label>
                        <input asp-for="Name" class="form-control" placeholder="Ex.: Maquininha Caixa 01" maxlength="50" autofocus />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 col-lg-4 mb-3">
                        <label asp-for="PaymentProviderId" class="form-label">
                            Fornecedor
                        </label>

                        <select asp-for="PaymentProviderId" asp-items="Model.PaymentProviders" class="form-select">
                            <option value="">Selecione o fornecedor</option>
                        </select>

                        <span asp-validation-for="PaymentProviderId" class="text-danger">
                        </span>
                    </div>
                </div>

                <hr />
                @{
                    var fab = new FloatingButtonDto
                    {
                        MainIcon = "bi bi-save",
                        IsSubmit = true
                    };
                }

                <partial name="_FloatingButtons" model="fab" />
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}