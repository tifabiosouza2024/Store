@model CashClosingViewModel

@{
    ViewData["Title"] = "Fechamento de Caixa";
}

<div class="container-fluid">
    <form asp-action="Close" asp-controller="CashSession" method="post" id="closingForm">
        <input type="hidden" asp-for="CashRegisterSessionId" />
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="mb-1">
                    <i class="bi bi-cash-stack me-2"></i>
                    Fechamento de Caixa
                </h3>
                <p class="text-muted mb-0">
                    Confira os valores e informe a apuração do caixa.
                </p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Voltar
            </a>
        </div>

        <!-- Informações da sessão -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-4 mb-3 mb-md-0">
                        <small class="text-muted d-block">Sessão de caixa</small>
                        <strong>#@Model.CashRegisterSessionId</strong>
                    </div>
                    <div class="col-md-4 mb-3 mb-md-0">
                        <small class="text-muted d-block">Abertura</small>
                        <strong>
                            @Model.OpenedAt.ToString("dd/MM/yyyy HH:mm")
                        </strong>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted d-block">Valor inicial</small>
                        <h4 class="mb-0 text-primary">
                            @Model.OpeningAmount.ToString("C")
                        </h4>
                        <input type="hidden" asp-for="OpeningAmount" />
                    </div>

                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Coluna principal -->
            <div class="col-lg-8">
                <!-- Abertura -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <i class="bi bi-wallet2 fs-2"></i>
                            Abertura de Caixa:
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-light border mb-3">
                            <small class="text-muted d-block">
                                Valor informado na abertura de caixa:
                            </small>
                            <strong class="fs-5">
                                @Model.OpeningAmount.ToString("C")
                            </strong>
                        </div>
                    </div>
                </div>
                <!-- Movimentações -->
                @if (Model.CashMovements.Any())
                {
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-white py-3">
                            <h5 class="mb-0">
                                <svg fill="#000000" height="30px" width="30px" version="1.1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" xmlns:xlink="http://www.w3.org/1999/xlink" enable-background="new 0 0 512 512"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <g> <g> <path d="M371.9,144L475,171.1L501,68l-19.8-5.2l-16.9,64.3C421.1,57.4,344,11,256,11C120.7,11,11,120.7,11,256 c0,135.3,109.7,245,245,245c90.3,0,169.1-48.8,211.6-121.5l-17.7-9.6c-39.1,66.4-111.3,111-193.9,111 C131.8,480.9,31.1,380.2,31.1,256S131.8,31.1,256,31.1c83.3,0,156.1,45.3,194.9,112.7l-73.8-19.6L371.9,144z"></path> <path d="m266.8,364.7v-18.7c17.7-1 31.2-6.2 41.6-15.6s15.6-21.9 15.6-36.4c0-15.6-4.2-27.1-13.5-34.4-9.4-8.3-22.9-14.6-42.7-18.7h-1v-47.9c13.5,2.1 25,6.2 36.4,14.6l16.7-22.9c-16.7-11.5-34.4-17.7-53.1-18.7v-12.5h-15.6v12.5c-15.6,1-29.2,6.2-39.6,15.6-10.4,9.4-15.6,21.9-15.6,36.4s4.2,26 13.5,33.3c8.3,7.3 22.9,13.5 41.6,17.7v48.9c-14.6-2.1-29.2-9.4-43.7-21.9l-18.7,21.9c18.7,16.7 39.6,26 62.5,28.1v18.7h15.6zm1-90.6c10.4,3.1 16.7,6.2 20.8,9.4 3.1,4.2 5.2,8.3 5.2,14.6s-2.1,10.4-7.3,14.6c-5.2,4.2-11.5,6.2-18.7,7.3v-45.9zm-36.4-44.7c-3.1-3.1-5.2-8.3-5.2-13.5 0-6.2 2.1-10.4 6.2-14.6 5.2-4.2 10.4-6.2 18.7-7.3v44.8c-10.4-3.2-16.6-6.3-19.7-9.4z"></path> </g> </g> </g></svg>
                                Movimentações realizadas em dinheiro:
                            </h5>
                        </div>
                        @if (Model.CashMovements.Any(c => c.CashMovementType == CashMovementTypeEnum.CashInflows))
                        {
                            <div class="card-body">
                                <div class="alert alert-light border mb-3">
                                    <label asp-for="CashAmount" class="form-label fw-semibold">
                                        Dinheiros adicionado ao caixa:
                                    </label>
                                    @foreach (var suply in Model.CashMovements.Where(c => c.CashMovementType == CashMovementTypeEnum.CashInflows))
                                    {
                                        <small class="text-muted d-block">
                                            @suply.Description
                                        </small>
                                        <strong class="fs-5">
                                            @suply.Amount.ToString("C")
                                        </strong>
                                    }
                                </div>
                            </div>
                        }
                        @if (Model.CashMovements.Any(c => c.CashMovementType == CashMovementTypeEnum.Withdrawal))
                        {
                            <div class="card-body">
                                <div class="alert alert-light border mb-3">
                                    <label asp-for="CashAmount" class="form-label fw-semibold">
                                        Sangria (Dinheiro retirado do caixa):
                                    </label>
                                    @foreach (var suply in Model.CashMovements.Where(c => c.CashMovementType == CashMovementTypeEnum.Withdrawal))
                                    {
                                        <small class="text-muted d-block">
                                            @(suply.Description ?? suply.OccurredAt.ToString("g"))
                                        </small>
                                        <strong class="fs-5">
                                            @suply.Amount.ToString("C")
                                        </strong>
                                    }
                                </div>
                            </div>
                        }
                        @if (Model.CashMovements.Any(c => c.CashMovementType == CashMovementTypeEnum.Expense))
                        {
                            <div class="card-body">
                                <div class="alert alert-light border mb-3">
                                    <label asp-for="CashAmount" class="form-label fw-semibold">
                                        Despesas pagas em dinheiro:
                                    </label>
                                    @foreach (var suply in Model.CashMovements.Where(c => c.CashMovementType == CashMovementTypeEnum.Expense))
                                    {
                                        <small class="text-muted d-block">
                                            @suply.Description
                                        </small>
                                        <strong class="fs-5">
                                            @suply.Amount.ToString("C")
                                        </strong>
                                    }
                                </div>
                            </div>
                        }

                    </div>

                }

                
                <!-- Fechamento em dinheiro -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <svg class="fs-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" height="24px" width="24px" fill="#000000"><path d="M7,8Q6.18,8 5.59,7.41T5,6V4Q5,3.17 5.59,2.59T7,2H17q0.82,0 1.41,0.59T19,4V6q0,0.82-0.59,1.41T17,8H7ZM7,6H17V4H7V6ZM4,22q-0.82,0-1.41-0.59T2,20V19H22v1q0,0.82-0.59,1.41T20,22H4ZM2,18l3.48-7.83Q5.73,9.63 6.23,9.31T7.3,9h9.4q0.58,0 1.08,0.31t0.75,0.86L22,18H2Zm6.5-2h1q0.2,0 0.35-0.15T10,15.5T9.85,15.15T9.5,15h-1q-0.2,0-0.35,0.15T8,15.5t0.15,0.35T8.5,16Zm0-2h1q0.2,0 0.35-0.15T10,13.5T9.85,13.15T9.5,13h-1q-0.2,0-0.35,0.15T8,13.5t0.15,0.35T8.5,14Zm0-2h1q0.2,0 0.35-0.15T10,11.5T9.85,11.15T9.5,11h-1q-0.2,0-0.35,0.15T8,11.5t0.15,0.35T8.5,12Zm3,4h1q0.2,0 0.35-0.15T13,15.5t-0.15-0.35T12.5,15h-1q-0.2,0-0.35,0.15T11,15.5t0.15,0.35T11.5,16Zm0-2h1q0.2,0 0.35-0.15T13,13.5t-0.15-0.35T12.5,13h-1q-0.2,0-0.35,0.15T11,13.5t0.15,0.35T11.5,14Zm0-2h1q0.2,0 0.35-0.15T13,11.5t-0.15-0.35T12.5,11h-1q-0.2,0-0.35,0.15T11,11.5t0.15,0.35T11.5,12Zm3,4h1q0.2,0 0.35-0.15T16,15.5t-0.15-0.35T15.5,15h-1q-0.2,0-0.35,0.15T14,15.5t0.15,0.35T14.5,16Zm0-2h1q0.2,0 0.35-0.15T16,13.5t-0.15-0.35T15.5,13h-1q-0.2,0-0.35,0.15T14,13.5t0.15,0.35T14.5,14Zm0-2h1q0.2,0 0.35-0.15T16,11.5t-0.15-0.35T15.5,11h-1q-0.2,0-0.35,0.15T14,11.5t0.15,0.35T14.5,12Z" /></svg>
                            Fechamento (dinheiro)
                        </h5>
                    </div>
                    <div class="card-body">
                        <label asp-for="CashAmount" class="form-label fw-semibold">
                            Dinheiro encontrado no caixa no momento do fechamento:
                        </label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text">R$</span>
                            <input asp-for="CashAmount" class="form-control price" inputmode="decimal" placeholder="0,00" autocomplete="off" />
                        </div>
                        <div class="form-text">
                            Informe o valor total contado fisicamente no caixa.
                        </div>
                        <span asp-validation-for="CashAmount" class="text-danger"></span>
                    </div>
                </div>

                <!-- Terminais -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-1">
                            <i class="bi bi-credit-card me-2"></i>
                            Conferência dos terminais (Maquininhas)
                        </h5>
                        <small class="text-muted">
                            Informe os valores apurados em cada terminal.
                        </small>
                    </div>
                    <div class="card-body">
                        @if (Model.Terminals.Any())
                        {
                            @for (int i = 0; i < Model.Terminals.Count; i++)
                            {
                                <div class="terminal-item border rounded-3 p-3 mb-3">
                                    <input type="hidden" asp-for="Terminals[i].PaymentTerminalId" />
                                    <input type="hidden" asp-for="Terminals[i].TerminalName" />
                                    <input type="hidden" asp-for="Terminals[i].ProviderName" />

                                    <div class="d-flex align-items-center mb-3">
                                        <div>
                                            <img src="~/img/@Model.Terminals[i].ProviderLogo" width="100" />
                                            <h6 class="mb-0">@Model.Terminals[i].TerminalName</h6>
                                        </div>
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <label class="form-label">Crédito</label>
                                            <div class="input-group">
                                                <span class="input-group-text">R$</span>
                                                <input asp-for="Terminals[i].CreditAmount" class="form-control price terminal-value" inputmode="decimal" autocomplete="off" />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Débito</label>
                                            <div class="input-group">
                                                <span class="input-group-text">R$</span>
                                                <input asp-for="Terminals[i].DebitAmount" class="form-control price terminal-value" inputmode="decimal" autocomplete="off" />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Pix</label>
                                            <div class="input-group">
                                                <span class="input-group-text">R$</span>
                                                <input asp-for="Terminals[i].PixAmount" class="form-control price terminal-value" inputmode="decimal" autocomplete="off" />
                                            </div>
                                        </div>
                                        <div class="col-md-4 ms-md-auto">
                                            <label class="form-label fw-semibold">Total do terminal</label>
                                            <div class="input-group">
                                                <span class="input-group-text">R$</span>
                                                <input type="text" class="form-control bg-light fw-bold text-end terminal-total" value="0,00" readonly tabindex="-1" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-credit-card fs-1 text-muted"></i>
                                <p class="text-muted mt-2 mb-0">Nenhum terminal cadastrado nesta operação.</p>
                                <a asp-action="Create" asp-controller="PaymentTerminal" class="btn btn-primary">
                                    <i class="bi bi-plus"></i> Novo
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <!-- Observações -->
                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <i class="bi bi-chat-left-text me-2"></i>
                            Observações
                            <small class="text-muted fw-normal">(opcional)</small>
                        </h5>
                    </div>

                    <div class="card-body">
                        <textarea asp-for="Notes" class="form-control" rows="3" maxlength="255" placeholder="Registre alguma ocorrência ou observação sobre o fechamento..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Resumo -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm position-sticky" style="top: 20px;">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <i class="bi bi-calculator me-2"></i>
                            Resumo do fechamento
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <small class="text-muted d-block">
                                Abertura:
                            </small>
                            <strong id="opened">
                                @Model.OpeningAmount.ToString("c")
                            </strong>
                        </div>
                        <div class="mb-3">
                            <small class="text-muted d-block">
                                Total de Suprimentos:
                            </small>
                            <strong id="cash-inflows">
                                @Model.CashMovements.Where(c => c.CashMovementType == CashMovementTypeEnum.CashInflows).Sum(c => c.Amount).ToString("c")
                            </strong>
                        </div>
                        <div class="mb-3">
                            <small class="text-muted d-block">
                                Total de Sangrias:
                            </small>
                            <strong id="withdrawals">
                                @Model.CashMovements.Where(c => c.CashMovementType == CashMovementTypeEnum.Withdrawal).Sum(c => c.Amount).ToString("c")
                            </strong>
                        </div>
                        <div class="mb-3">
                            <small class="text-muted d-block">
                                Total de Despesas:
                            </small>
                            <strong id="expenses">
                                @Model.CashMovements.Where(c => c.CashMovementType == CashMovementTypeEnum.Expense).Sum(c => c.Amount).ToString("c")
                            </strong>
                        </div>
                        <div class="mb-3">
                            <small class="text-muted d-block">
                                Fechamento:
                            </small>
                            <strong id="summaryCash">
                                R$ 0,00
                            </strong>
                        </div>
                        <div class="mb-3">
                            <small class="text-muted d-block">
                                Total Crédito
                            </small>
                            <strong id="summaryCredit">
                                R$ 0,00:
                            </strong>
                        </div>
                        <div class="mb-3">
                            <small class="text-muted d-block">
                                Total Débito:
                            </small>
                            <strong id="summaryDebit">
                                R$ 0,00
                            </strong>
                        </div>
                        <div class="mb-3">
                            <small class="text-muted d-block">
                                Total Pix:
                            </small>
                            <strong id="summaryPix">
                                R$ 0,00
                            </strong>
                        </div>
                        <hr />
                        <small class="text-muted d-block">
                            Valor total da venda
                        </small>
                        <h3 class="text-primary mb-0" id="summaryTotal">
                            R$ 0,00
                        </h3>
                    </div>

                    <div class="card-footer bg-white p-3">
                        <button type="button" class="btn btn-success btn-lg w-100" data-bs-toggle="modal" data-bs-target="#confirmClosingModal">
                            <i class="bi bi-check-circle me-2"></i>
                            Confirmar fechamento
                        </button>
                        <small class="text-muted d-block text-center mt-2">
                            Confira os valores antes de finalizar.
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal de confirmação -->
        <div class="modal fade" id="confirmClosingModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            Confirmar fechamento?
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal">
                        </button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0">
                            Ao confirmar, a sessão será encerrada e não poderá
                            mais receber movimentações.
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            Revisar valores
                        </button>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-lg me-1"></i>
                            Sim, fechar caixa
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>



@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('closingForm');

            if (!form) return;

            const currency = new Intl.NumberFormat('pt-BR', {
                style: 'currency',
                currency: 'BRL'
            });

            function parseValue(input) {
                if (!input) return 0;

                let value = input.inputmask
                    ? input.inputmask.unmaskedvalue()
                    : input.value;

                value = String(value ?? '').trim();

                if (!value) return 0;

                if (value.includes(',')) {
                    value = value.replace(/\./g, '').replace(',', '.');
                }

                value = value.replace(/[^\d.-]/g, '');

                const result = Number(value);

                return Number.isFinite(result) ? result : 0;
            }

            function sum(selector) {
                return [...form.querySelectorAll(selector)]
                    .reduce((total, input) => total + parseValue(input), 0);
            }

            // Atualiza o total individual de cada terminal.
            function updateTerminalTotals() {
                form.querySelectorAll('.terminal-item').forEach(terminal => {
                    const total = [...terminal.querySelectorAll('.terminal-value')]
                        .reduce((value, input) => value + parseValue(input), 0);

                    const output = terminal.querySelector('.terminal-total');

                    if (output) {
                        output.value = total.toLocaleString('pt-BR', {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        });
                    }
                });
            }

            function updateSummary() {
                updateTerminalTotals();

                const cash = parseValue(form.querySelector('#CashAmount'));

                const credit = sum('[id$="_CreditAmount"]');
                const debit = sum('[id$="_DebitAmount"]');
                const pix = sum('[id$="_PixAmount"]');

                const opened = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpeningAmount));
                const withdrawals = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Withdrawals));
                const expenses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Expenses));
                const suplys = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Supplys));

                document.getElementById('summaryCash').textContent = currency.format(cash);
                document.getElementById('summaryCredit').textContent = currency.format(credit);
                document.getElementById('summaryDebit').textContent = currency.format(debit);
                document.getElementById('summaryPix').textContent = currency.format(pix);

                document.getElementById('summaryTotal').textContent = currency.format(
                    cash + credit + debit + pix + withdrawals + expenses - suplys - opened
                );
            }

            form.addEventListener('input', updateSummary, true);
            form.addEventListener('change', updateSummary, true);
            form.addEventListener('keyup', updateSummary, true);

            updateSummary();
        });
    </script>

    <script>
        document.getElementById('closingForm').addEventListener('submit', function () {
            const data = new FormData(this);

            console.table(
                [...data.entries()].map(([name, value]) => ({
                    Campo: name,
                    Valor: value
                }))
            );
        });
    </script>
}
