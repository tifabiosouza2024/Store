@model CashSessionIndexViewModel

@{
    ViewData["Title"] = "Caixas Abertos";

    var sessions = Model.CashRegisterSessionsOpened;
    var hasSessions = sessions != null && sessions.Any();
    var totalOpeningAmount = sessions?.Sum(s => s.OpeningAmount) ?? 0m;
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                <i class="bi bi-cash-stack fs-3"></i>
            </div>

            <div>
                <h2 class="mb-1">Caixas Abertos</h2>
                <p class="text-muted mb-0">
                    Acompanhe as sessões de caixa em andamento.
                </p>
            </div>
        </div>
    </div>

    @if (hasSessions)
    {
        <div class="row g-3 mb-4">

            <div class="col-12 col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                            <i class="bi bi-shop fs-4"></i>
                        </div>
                        <div>
                            <div class="text-muted small">
                                Sessões ativas
                            </div>
                            <div class="fs-3 fw-semibold">
                                @sessions!.Count()
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="bg-success bg-opacity-10 text-success rounded-3 p-3">
                            <i class="bi bi-wallet2 fs-4"></i>
                        </div>
                        <div>
                            <div class="text-muted small">
                                Total de abertura
                            </div>
                            <div class="fs-3 fw-semibold">
                                @totalOpeningAmount.ToString("C")
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="card border-0 shadow-sm">

            <div class="card-header bg-body border-0 px-4 pt-4 pb-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <h5 class="mb-1">Sessões de caixa</h5>
                        <p class="text-muted small mb-0">
                            Confira os valores e os responsáveis pelas aberturas.
                        </p>
                    </div>

                    <span class="badge text-bg-success rounded-pill px-3 py-2">
                        <i class="bi bi-circle-fill me-1 small"></i>Em andamento
                    </span>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="pe-4"></th>
                            <th class="ps-4 text-nowrap">Caixa</th>
                            <th class="ps-4 text-nowrap">Aberto em</th>
                            <th class="text-end text-nowrap">Valor inicial</th>
                            <th class="text-nowrap">Status</th>
                            <th>Operação</th>
                            <th class="pe-4">Aberto por</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var session in sessions!)
                        {
                            <tr>
                                <td>
                                    <a class="btn btn-success" asp-action="Supply" asp-controller="CashMovement" asp-route-cashSessionId="@session.Id" title="Adicionar Suprimento">
                                        <i class="bi bi-arrow-up-circle me-1"></i>
                                    </a>
                                    <a class="btn btn-success" asp-action="Withdrawal" asp-controller="CashMovement" asp-route-cashSessionId="@session.Id" title="Realizar Sangria">
                                        <i class="bi bi-arrow-down-circle me-1"></i>
                                    </a>
                                    <a class="btn btn-success" asp-action="Expense" asp-controller="CashMovement" asp-route-cashSessionId="@session.Id" title="Registrar Despesas">
                                        <svg width="24px" height="24px" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg" fill="#ffffff" stroke="#ffffff"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path fill="#ffffff" d="M298.9 24.31c-14.9.3-25.6 3.2-32.7 8.4l-97.3 52.1-54.1 73.59c-11.4 17.6-3.3 51.6 32.3 29.8l39-51.4c49.5-42.69 150.5-23.1 102.6 62.6-23.5 49.6-12.5 73.8 17.8 84l13.8-46.4c23.9-53.8 68.5-63.5 66.7-106.9l107.2 7.7-1-112.09-194.3-1.4zM244.8 127.7c-17.4-.3-34.5 6.9-46.9 17.3l-39.1 51.4c10.7 8.5 21.5 3.9 32.2-6.4 12.6 6.4 22.4-3.5 30.4-23.3 3.3-13.5 8.2-23 23.4-39zm-79.6 96c-.4 0-.9 0-1.3.1-3.3.7-7.2 4.2-9.8 12.2-2.7 8-3.3 19.4-.9 31.6 2.4 12.1 7.4 22.4 13 28.8 5.4 6.3 10.4 8.1 13.7 7.4 3.4-.6 7.2-4.2 9.8-12.1 2.7-8 3.4-19.5 1-31.6-2.5-12.2-7.5-22.5-13-28.8-4.8-5.6-9.2-7.6-12.5-7.6zm82.6 106.8c-7.9.1-17.8 2.6-27.5 7.3-11.1 5.5-19.8 13.1-24.5 20.1-4.7 6.9-5.1 12.1-3.6 15.2 1.5 3 5.9 5.9 14.3 6.3 8.4.5 19.7-1.8 30.8-7.3 11.1-5.5 19.8-13 24.5-20 4.7-6.9 5.1-12.2 3.6-15.2-1.5-3.1-5.9-5.9-14.3-6.3-1.1-.1-2.1-.1-3.3-.1zm-97.6 95.6c-4.7.1-9 .8-12.8 1.9-8.5 2.5-13.4 7-15 12.3-1.7 5.4 0 11.8 5.7 18.7 5.8 6.8 15.5 13.3 27.5 16.9 11.9 3.6 23.5 3.5 32.1.9 8.6-2.5 13.5-7 15.1-12.3 1.6-5.4 0-11.8-5.8-18.7-5.7-6.8-15.4-13.3-27.4-16.9-6.8-2-13.4-2.9-19.4-2.8z"></path></g></svg>
                                    </a>
                                    @if (User.IsManagerOrGreater())
                                    {
                                        <a class="btn btn-success" asp-action="Edit" asp-controller="CashSession" asp-route-id="@session.Id" title="Editar Abertura de Caixa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    }
                                    <a class="btn btn-success" asp-action="Index" asp-controller="CashMovement" asp-route-cashSessionId="@session.Id" title="Ver Movimentações de Caixa">
                                        <i class="bi bi-card-list"></i>
                                    </a>
                                    <a class="btn btn-success" asp-action="Close" asp-route-id="@session.Id" title="Fechar Caixa">
                                        <svg class="fs-2 text-success" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" height="24px" width="24px" fill="#ffffff"><path d="M7,8Q6.18,8 5.59,7.41T5,6V4Q5,3.17 5.59,2.59T7,2H17q0.82,0 1.41,0.59T19,4V6q0,0.82-0.59,1.41T17,8H7ZM7,6H17V4H7V6ZM4,22q-0.82,0-1.41-0.59T2,20V19H22v1q0,0.82-0.59,1.41T20,22H4ZM2,18l3.48-7.83Q5.73,9.63 6.23,9.31T7.3,9h9.4q0.58,0 1.08,0.31t0.75,0.86L22,18H2Zm6.5-2h1q0.2,0 0.35-0.15T10,15.5T9.85,15.15T9.5,15h-1q-0.2,0-0.35,0.15T8,15.5t0.15,0.35T8.5,16Zm0-2h1q0.2,0 0.35-0.15T10,13.5T9.85,13.15T9.5,13h-1q-0.2,0-0.35,0.15T8,13.5t0.15,0.35T8.5,14Zm0-2h1q0.2,0 0.35-0.15T10,11.5T9.85,11.15T9.5,11h-1q-0.2,0-0.35,0.15T8,11.5t0.15,0.35T8.5,12Zm3,4h1q0.2,0 0.35-0.15T13,15.5t-0.15-0.35T12.5,15h-1q-0.2,0-0.35,0.15T11,15.5t0.15,0.35T11.5,16Zm0-2h1q0.2,0 0.35-0.15T13,13.5t-0.15-0.35T12.5,13h-1q-0.2,0-0.35,0.15T11,13.5t0.15,0.35T11.5,14Zm0-2h1q0.2,0 0.35-0.15T13,11.5t-0.15-0.35T12.5,11h-1q-0.2,0-0.35,0.15T11,11.5t0.15,0.35T11.5,12Zm3,4h1q0.2,0 0.35-0.15T16,15.5t-0.15-0.35T15.5,15h-1q-0.2,0-0.35,0.15T14,15.5t0.15,0.35T14.5,16Zm0-2h1q0.2,0 0.35-0.15T16,13.5t-0.15-0.35T15.5,13h-1q-0.2,0-0.35,0.15T14,13.5t0.15,0.35T14.5,14Zm0-2h1q0.2,0 0.35-0.15T16,11.5t-0.15-0.35T15.5,11h-1q-0.2,0-0.35,0.15T14,11.5t0.15,0.35T14.5,12Z" /></svg>
                                    </a>
                                </td>
                                <td class="ps-4 text-nowrap">
                                    <div class="fw-medium">
                                        @session.CashSessionNumber
                                    </div>
                                </td>
                                <td class="ps-4 text-nowrap">
                                    <div class="fw-medium">
                                        @session.OpenedAt.ToString("dd/MM/yyyy")
                                    </div>
                                    <div class="text-muted small">
                                        @session.OpenedAt.ToString("HH:mm")
                                    </div>
                                </td>
                                <td class="text-end text-nowrap fw-semibold">
                                    @session.OpeningAmount.ToString("C")
                                </td>
                                <td>
                                    <span class="badge text-bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                        @session.CashRegisterStatus
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-shop text-muted"></i>
                                        <span>
                                            @(session.Operation?.Name ?? "Não informada")
                                        </span>
                                    </div>
                                </td>
                                <td class="pe-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-person-circle fs-5 text-muted"></i>
                                        <span>
                                            @(session.OpenedByUser?.Name ?? "Não informado")
                                        </span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th class="ps-4" colspan="1">Total</th>
                            <th class="text-end">@totalOpeningAmount.ToString("C")</th>
                            <th colspan="5"></th>
                        </tr>
                    </tfoot>

                </table>
            </div>

            <div class="card-footer bg-body border-0 px-4 py-3">
                <small class="text-muted">
                    Exibindo @sessions!.Count() @(sessions.Count() == 1 ? "sessão ativa" : "sessões ativas").
                </small>
            </div>

        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5 px-4">

                <div class="bg-body-secondary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 88px; height: 88px;">
                    <i class="bi bi-cash-stack display-5 text-secondary"></i>
                </div>

                <h4 class="mb-2">Nenhum caixa aberto</h4>

                <p class="text-muted mx-auto mb-4" style="max-width: 420px;">
                    Não existem sessões de caixa em andamento. Você pode iniciar uma nova abertura para registrar o valor inicial da operação.
                </p>

                <a asp-area="Admin" asp-controller="CashSession" asp-action="Open" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>
                    Abrir caixa
                </a>

            </div>
        </div>
    }

</div>

@{
    var fab = new FloatingButtonDto
    {
        MainUrl = "/Admin/CashSession/Open"
    };
}

<partial name="_FloatingButtons" model="fab" />
