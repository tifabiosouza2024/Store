@model CashSessionIndexViewModel

@{
    ViewData["Title"] = "Caixas Abertos";

    var pagination = Model.CashRegisterSessionsOpened;
    var sessions = pagination?.Data?.ToList() ?? [];
    var hasSessions = sessions.Count > 0;
    var totalOpeningAmount = sessions.Sum(s => s.OpeningAmount);

    var sortableFields = new[]
    {
        new { Field = "CashSessionNumber", Label = "Caixa" },
        new { Field = "OpenedAt", Label = "Aberto em" },
        new { Field = "OpeningAmount", Label = "Valor Inicial" },
        new { Field = "OpenedByUser.Name", Label = "Aberto por" }
    };

    var mobileSorts = new List<(string Field, string Label, string Direction)>();

    foreach (var query in Context.Request.Query)
    {
        if (!query.Key.StartsWith("orderBy", StringComparison.OrdinalIgnoreCase))
            continue;

        var field = sortableFields.FirstOrDefault(x =>
            string.Equals($"orderBy{x.Field}", query.Key, StringComparison.OrdinalIgnoreCase));

        var direction = query.Value.ToString().ToLowerInvariant();

        if (field != null && (direction == "asc" || direction == "desc"))
            mobileSorts.Add((field.Field, field.Label, direction));
    }

    if (mobileSorts.Count == 0)
        mobileSorts.Add(("OpenedAt", "Aberto em", "desc"));
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/table.css" asp-append-version="true" />

    <style>
        /* Indicadores */
        .cash-summary-icon {
            width: 52px;
            height: 52px;
            flex-shrink: 0;
            display: grid;
            place-items: center;
            border-radius: 12px;
        }

        /* Cards mobile */
        .cash-session-card {
            border: 1px solid var(--border-color);
            border-radius: 12px;
            background: white;
            transition: box-shadow .2s ease;
        }

            .cash-session-card:hover {
                box-shadow: 0 3px 12px rgb(0 0 0 / 5%);
            }

        .cash-session-number {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--text-main);
        }

        .cash-session-amount {
            padding: 13px 15px;
            background: var(--app-bg);
            border-radius: 9px;
        }

        .cash-session-info {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
        }

        .cash-session-info-icon {
            width: 36px;
            height: 36px;
            flex-shrink: 0;
            display: grid;
            place-items: center;
            border-radius: 9px;
            background: var(--app-bg);
            color: var(--text-muted);
        }

        .cash-session-info-content {
            min-width: 0;
        }

            .cash-session-info-content .value {
                font-weight: 500;
                overflow-wrap: anywhere;
            }

        .cash-session-actions .dropdown-menu {
            min-width: 220px;
        }

        .cash-session-actions .dropdown-item {
            padding: 9px 14px;
            font-size: .9rem;
        }

            .cash-session-actions .dropdown-item i {
                width: 20px;
                display: inline-block;
            }

            .cash-session-actions .dropdown-item svg {
                width: 20px;
                height: 20px;
                vertical-align: middle;
                margin-right: 8px;
            }

        .cash-session-table-actions svg {
            width: 20px;
            height: 20px;
            vertical-align: middle;
        }

        /* Ajustes para telas pequenas */
        @@media (max-width: 575.98px) {
            .cash-summary-icon {
                width: 42px;
                height: 42px;
            }

                .cash-summary-icon i {
                    font-size: 1.2rem !important;
                }

            .cash-summary-value {
                font-size: 1.2rem !important;
            }

            .cash-session-card-body {
                padding: 14px !important;
            }
        }
    </style>
}

<div class="container py-4">
    @* Cabeçalho *@
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                <i class="bi bi-cash-stack fs-3"></i>
            </div>
            <div>
                <h2 class="mb-1">Caixas Abertos</h2>
                <p class="text-muted mb-0">
                    Acompanhe as sessões de caixa em andamento.
                </p>
            </div>
        </div>
    </div>

    @if (hasSessions)
    {
        @* Indicadores *@
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body d-flex align-items-center gap-2 gap-md-3">
                        <div class="cash-summary-icon bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-shop fs-4"></i>
                        </div>
                        <div class="min-w-0">
                            <div class="text-muted small">
                                Sessões ativas
                            </div>
                            <div class="fs-3 fw-semibold cash-summary-value">
                                @pagination!.TotalItems
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body d-flex align-items-center gap-2 gap-md-3">
                        <div class="cash-summary-icon bg-success bg-opacity-10 text-success">
                            <i class="bi bi-wallet2 fs-4"></i>
                        </div>
                        <div class="min-w-0">
                            <div class="text-muted small">
                                Total de abertura
                            </div>
                            <div class="fs-5 fs-md-4 fw-semibold text-truncate cash-summary-value">
                                @totalOpeningAmount.ToString("C")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Listagem *@
        <div class="card border-0 shadow-sm">

            @* Cabeçalho da listagem *@
            <div class="card-header bg-body border-0 px-3 px-md-4 pt-4 pb-3">

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

                    <div>
                        <h5 class="mb-1">Sessões de caixa</h5>
                        <p class="text-muted small mb-0">
                            Confira os valores e os responsáveis pelas aberturas.
                        </p>
                    </div>

                    <span class="badge text-bg-success rounded-pill px-3 py-2">
                        <i class="bi bi-circle-fill me-1 small"></i>
                        Em andamento
                    </span>

                </div>

            </div>

            @* =========================================
               DESKTOP - TABELA
            ========================================= *@

            <div class="d-none d-lg-block">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="pe-4"></th>
                                    <th table-header-ordered field="CashSessionNumber" header-text="Caixa" is-number></th>
                                    <th table-header-ordered field="OpenedAt" header-text="Aberto em" is-number></th>
                                    <th table-header-ordered field="OpeningAmount" header-text="Valor Inicial" is-number></th>
                                    <th>Status</th>
                                    <th>Operação</th>
                                    <th table-header-ordered field="OpenedByUser.Name" header-text="Aberto por"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var session in sessions)
                                {
                                    <tr>
                                        @* Ações *@
                                        <td class="text-start pe-4">
                                            <div class="btn-group cash-session-table-actions" role="group">
                                                <partial name="Components/Buttons/_BtnAddSupply" model="new ButtonsViewModels(session?.Id)" />
                                                <partial name="Components/Buttons/_BtnAddWithdrawal" model="new ButtonsViewModels(session?.Id)" />
                                                <partial name="Components/Buttons/_BtnAddExpense" model="new ButtonsViewModels(session?.Id)" />
                                                @if (User.IsManagerOrGreater())
                                                {
                                                    <partial name="Components/Buttons/_BtnEditSession" model="new ButtonsViewModels(session?.Id)" />
                                                }
                                                <partial name="Components/Buttons/_BtnViewMovements" model="new ButtonsViewModels(session?.Id)" />
                                                <partial name="Components/Buttons/_BtnCloseSession" model="new ButtonsViewModels(session?.Id)" />
                                            </div>
                                        </td>
                                        <td class="fw-semibold">
                                            #@session.CashSessionNumber
                                        </td>
                                        <td class="text-nowrap">
                                            <div class="fw-medium">
                                                @session.OpenedAt.ToString("dd/MM/yyyy")
                                            </div>
                                            <div class="text-muted small">
                                                @session.OpenedAt.ToString("HH:mm")
                                            </div>
                                        </td>
                                        <td class="text-end text-nowrap fw-semibold">
                                            @session.OpeningAmount.ToString("C")
                                        </td>
                                        <td>
                                            <span class="badge text-bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                                @session.CashRegisterStatus
                                            </span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-shop text-muted"></i>
                                                <span>
                                                    @(session.Operation?.Name ?? "Não informada")
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-person-circle fs-5 text-muted"></i>
                                                <span>
                                                    @(session.OpenedByUser?.Name ?? "Não informado")
                                                </span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <th colspan="2">Total da página</th>
                                    <th class="text-end">
                                        @totalOpeningAmount.ToString("C")
                                    </th>
                                    <th colspan="4"></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
            @* =========================================
               MOBILE - CARDS
            ========================================= *@
            <div class="d-lg-none">
                <div class="card-body p-3">

                    @* Ordenação mobile *@
                    <div class="mb-3" id="mobileSort">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label fw-semibold mb-0">Ordenar por</label>
                            <button type="button" class="btn btn-sm btn-outline-primary" id="addMobileSort">
                                <i class="bi bi-plus-circle me-1"></i> Adicionar campo
                            </button>
                        </div>

                        <div id="mobileSortCriteria" class="d-flex flex-column gap-2">
                            @foreach (var sort in mobileSorts)
                            {
                                <div class="row g-2 align-items-center" data-sort-row>
                                    <div class="col-6">
                                        <select class="form-select form-select-sm" data-sort-field>
                                            @foreach (var field in sortableFields)
                                            {
                                                <option value="@field.Field" selected="@(sort.Field == field.Field)">@field.Label</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-4">
                                        <select class="form-select form-select-sm" data-sort-direction>
                                            <option value="asc" selected="@(sort.Direction == "asc")">Crescente</option>
                                            <option value="desc" selected="@(sort.Direction == "desc")">Decrescente</option>
                                        </select>
                                    </div>
                                    <div class="col-2">
                                        <button type="button" class="btn btn-outline-danger btn-sm w-100" data-remove-sort title="Remover critério">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-end mt-2">
                            <button type="button" class="btn btn-primary btn-sm" id="applyMobileSort">
                                <i class="bi bi-sort-down me-1"></i> Aplicar ordenação
                            </button>
                        </div>
                    </div>

                    <template id="mobileSortTemplate">
                        <div class="row g-2 align-items-center" data-sort-row>
                            <div class="col-6">
                                <select class="form-select form-select-sm" data-sort-field>
                                    @foreach (var field in sortableFields)
                                    {
                                        <option value="@field.Field">@field.Label</option>
                                    }
                                </select>
                            </div>
                            <div class="col-4">
                                <select class="form-select form-select-sm" data-sort-direction>
                                    <option value="asc">Crescente</option>
                                    <option value="desc" selected>Decrescente</option>
                                </select>
                            </div>
                            <div class="col-2">
                                <button type="button" class="btn btn-outline-danger btn-sm w-100" data-remove-sort title="Remover critério">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </template>

                    <div class="d-flex flex-column gap-3">
                        @foreach (var session in sessions)
                        {
                            <div class="cash-session-card">
                                <div class="cash-session-card-body p-3">
                                    @* Identificação e ações *@
                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                                        <div>
                                            <div class="text-muted small mb-1">
                                                Número do caixa
                                            </div>
                                            <div class="cash-session-number">
                                                #@session.CashSessionNumber
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge text-bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                                @session.CashRegisterStatus
                                            </span>
                                            <div class="dropdown cash-session-actions">
                                                <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Ações do caixa">
                                                    <i class="bi bi-three-dots-vertical"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                    <li>
                                                        <partial name="Components/Buttons/_BtnAddSupply" model="new ButtonsViewModels(session?.Id, true)" />
                                                        
                                                    </li>
                                                    <li>
                                                        <partial name="Components/Buttons/_BtnAddWithdrawal" model="new ButtonsViewModels(session?.Id, true)" />
                                                    </li>
                                                    <li>
                                                        <partial name="Components/Buttons/_BtnAddExpense" model="new ButtonsViewModels(session?.Id, true)" />
                                                    </li>
                                                    <li>
                                                        <hr class="dropdown-divider" />
                                                    </li>
                                                    
                                                    @if (User.IsManagerOrGreater())
                                                    {
                                                        <li>
                                                            <partial name="Components/Buttons/_BtnEditSession" model="new ButtonsViewModels(session?.Id, true)" />
                                                        </li>
                                                    }
                                                    <li>
                                                        <partial name="Components/Buttons/_BtnViewMovements" model="new ButtonsViewModels(session?.Id, true)" />

                                                    </li>
                                                    <li>
                                                        <hr class="dropdown-divider" />
                                                    </li>

                                                    <li>
                                                        <partial name="Components/Buttons/_BtnCloseSession" model="new ButtonsViewModels(session?.Id, true)" />
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>

                                    @* Valor inicial *@
                                    <div class="cash-session-amount mb-3">
                                        <div class="text-muted small mb-1">
                                            Valor inicial
                                        </div>
                                        <div class="fs-4 fw-semibold">
                                            @session.OpeningAmount.ToString("C")
                                        </div>
                                    </div>

                                    @* Data de abertura *@
                                    <div class="d-flex flex-column gap-3">
                                        <div class="cash-session-info">
                                            <div class="cash-session-info-icon">
                                                <i class="bi bi-calendar3"></i>
                                            </div>
                                            <div class="cash-session-info-content">
                                                <div class="text-muted small">
                                                    Aberto em
                                                </div>
                                                <div class="value">
                                                    @session.OpenedAt.ToString("dd/MM/yyyy")
                                                    às @session.OpenedAt.ToString("HH:mm")
                                                </div>
                                            </div>
                                        </div>

                                        @* Operação *@
                                        <div class="cash-session-info">
                                            <div class="cash-session-info-icon">
                                                <i class="bi bi-shop"></i>
                                            </div>
                                            <div class="cash-session-info-content">

                                                <div class="text-muted small">
                                                    Operação
                                                </div>
                                                <div class="value">
                                                    @(session.Operation?.Name ?? "Não informada")
                                                </div>
                                            </div>
                                        </div>

                                        @* Responsável *@
                                        <div class="cash-session-info">
                                            <div class="cash-session-info-icon">
                                                <i class="bi bi-person-circle"></i>
                                            </div>
                                            <div class="cash-session-info-content">
                                                <div class="text-muted small">
                                                    Aberto por
                                                </div>
                                                <div class="value">
                                                    @(session.OpenedByUser?.Name ?? "Não informado")
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* Paginação única para desktop e mobile *@
            <div class="card-footer bg-body border-0 py-3 px-3 px-md-4">
                <partial name="_Pagination"
                         model="@(new PaginationViewModel
                         {
                             TotalItems = pagination!.TotalItems,
                             QttPerPage = pagination.QttPerPage,
                             CurrentPage = pagination.CurrentPage
                         })" />

            </div>
        </div>
    }
    else
    {
        @* Estado vazio *@
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5 px-4">
                <div class="bg-body-secondary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 88px; height: 88px;">
                    <i class="bi bi-cash-stack display-5 text-secondary"></i>
                </div>
                <h4 class="mb-2">
                    Nenhum caixa aberto
                </h4>
                <p class="text-muted mx-auto mb-4" style="max-width: 420px;">
                    Não existem sessões de caixa em andamento.
                    Você pode iniciar uma nova abertura para registrar
                    o valor inicial da operação.
                </p>
                <a asp-area="Admin" asp-controller="CashSession" asp-action="Open" class="btn btn-primary">

                    <i class="bi bi-plus-circle me-2"></i>
                    Abrir caixa
                </a>
            </div>
        </div>
    }

</div>

@{
    var fab = new FloatingButtonDto
    {
        MainUrl = "/Admin/CashSession/Open"
    };
}

<partial name="_FloatingButtons" model="fab" />

@section Scripts {
    <script src="~/js/admin/table.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const criteria = document.getElementById('mobileSortCriteria');
            const template = document.getElementById('mobileSortTemplate');
            const addButton = document.getElementById('addMobileSort');
            const applyButton = document.getElementById('applyMobileSort');

            if (!criteria || !template || !addButton || !applyButton)
                return;

            function updateSortOptions() {
                const selects = [...criteria.querySelectorAll('[data-sort-field]')];

                selects.forEach(select => {
                    [...select.options].forEach(option => {
                        option.disabled = selects.some(other =>
                            other !== select && other.value === option.value);
                    });
                });

                addButton.disabled = selects.length >= template.content.querySelectorAll('[data-sort-field] option').length;
                criteria.querySelectorAll('[data-remove-sort]').forEach(button => {
                    button.disabled = selects.length === 1;
                });
            }

            addButton.addEventListener('click', function () {
                const usedFields = [...criteria.querySelectorAll('[data-sort-field]')]
                    .map(select => select.value);

                const availableField = [...template.content.querySelectorAll('[data-sort-field] option')]
                    .find(option => !usedFields.includes(option.value));

                if (!availableField)
                    return;

                const newRow = template.content.firstElementChild.cloneNode(true);
                newRow.querySelector('[data-sort-field]').value = availableField.value;
                criteria.appendChild(newRow);

                updateSortOptions();
            });

            criteria.addEventListener('click', function (event) {
                const removeButton = event.target.closest('[data-remove-sort]');

                if (!removeButton || criteria.querySelectorAll('[data-sort-row]').length <= 1)
                    return;

                removeButton.closest('[data-sort-row]').remove();
                updateSortOptions();
            });

            criteria.addEventListener('change', updateSortOptions);

            applyButton.addEventListener('click', function () {
                const url = new URL(window.location.href);
                const rows = [...criteria.querySelectorAll('[data-sort-row]')];

                [...url.searchParams.keys()]
                    .filter(key => key.toLowerCase().startsWith('orderby'))
                    .forEach(key => url.searchParams.delete(key));

                rows.forEach(row => {
                    const field = row.querySelector('[data-sort-field]').value;
                    const direction = row.querySelector('[data-sort-direction]').value;

                    url.searchParams.set(`orderBy${field}`, direction);
                });

                url.searchParams.set('page', '1');

                window.history.replaceState({}, '', url);

                const applyTableChanges = document.getElementById('applyTableChanges');

                if (applyTableChanges) {
                    applyTableChanges.click();
                } else {
                    window.location.reload();
                }
            });

            updateSortOptions();
        });
    </script>
}