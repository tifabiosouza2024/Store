@model CashRegisterSession

@{
    ViewData["Title"] = $"Detalhes do Caixa #{Model.CashSessionNumber}";

    var status = (int)Model.CashRegisterStatus;

    var statusText = status switch
    {
        1 => "Aberto",
        2 => "Fechado",
        3 => "Cancelado",
        _ => "Desconhecido"
    };

    var statusClass = status switch
    {
        1 => "bg-success",
        2 => "bg-secondary",
        3 => "bg-danger",
        _ => "bg-light text-dark"
    };

    var closingBalance = Model.CashClosing == null
        ? (decimal?)null
        : Model.CashClosing.ClosingTotalSales - Model.OpeningAmount;

    var terminalCreditTotal = Model.CashClosingTerminals.Sum(x => x.CreditAmount);
    var terminalDebitTotal = Model.CashClosingTerminals.Sum(x => x.DebitAmount);
    var terminalPixTotal = Model.CashClosingTerminals.Sum(x => x.PixAmount);
    var terminalGrandTotal = terminalCreditTotal + terminalDebitTotal + terminalPixTotal;

    var supplyMovements = Model.CashMovements
        .Where(x => x.CashMovementType.ToString() is "CashInflows" or "Supply")
        .ToList();

    var withdrawalMovements = Model.CashMovements
        .Where(x => x.CashMovementType.ToString() == "Withdrawal")
        .ToList();

    var expenseMovements = Model.CashMovements
        .Where(x => x.CashMovementType.ToString() == "Expense")
        .ToList();

    var supplyTotal = supplyMovements.Sum(x => x.Amount);
    var withdrawalTotal = withdrawalMovements.Sum(x => x.Amount);
    var expenseTotal = expenseMovements.Sum(x => x.Amount);

    string MovementLabel(CashMovementTypeEnum type) => type.ToString() switch
    {
        "CashInflows" or "Supply" => "Suprimento",
        "Withdrawal" => "Sangria",
        "Expense" => "Despesa",
        _ => type.ToString()
    };

    string MovementClass(CashMovementTypeEnum type) => type.ToString() switch
    {
        "CashInflows" or "Supply" => "text-success",
        "Withdrawal" or "Expense" => "text-danger",
        _ => "text-secondary"
    };

    string MovementBadgeClass(CashMovementTypeEnum type) => type.ToString() switch
    {
        "CashInflows" or "Supply" => "bg-success-subtle text-success",
        "Withdrawal" => "bg-danger-subtle text-danger",
        "Expense" => "bg-danger-subtle text-danger",
        _ => "bg-secondary-subtle text-secondary"
    };
}

@section Styles {
    <style>
        .cash-history-card {
            background: #F1F4FA;
            border: 1px solid #e2e7f0;
            border-radius: 10px;
            padding: 16px;
        }

        .cash-history-info {
            background: #fff;
            border: 1px solid #e9edf4;
            border-radius: 8px;
            padding: 10px 12px;
            height: 100%;
        }

        .info-label {
            color: #6c757d;
            font-size: .75rem;
            margin-bottom: 3px;
        }

        .terminal-total-card {
            background: #eaf2ff;
            border: 1px solid #c5d8f5;
            border-radius: 10px;
            padding: 16px;
        }

        .terminal-total-info {
            background: rgba(255, 255, 255, .75);
            border: 1px solid #d7e4f7;
            border-radius: 8px;
            padding: 10px 12px;
            height: 100%;
        }

        .movement-summary-card {
            border: 1px solid #e9edf4;
            border-radius: 10px;
            padding: 14px 16px;
            height: 100%;
            background: #fff;
        }

        .movement-summary-icon {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 9px;
            font-size: 1.1rem;
        }
    </style>
}

<div class="container-fluid">

    <!-- Cabeçalho -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h4 class="mb-0">Caixa #@Model.CashSessionNumber</h4>
                <span class="badge @statusClass">@statusText</span>
            </div>
            <div class="text-muted small mt-1">
                @Model.Operation.Name
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Voltar
            </a>

            @if (status == 1)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="bi bi-pencil me-1"></i> Editar
                </a>
            }
        </div>
    </div>

    <!-- Resumo financeiro -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">
                        <i class="bi bi-wallet2 me-1"></i> Valor de abertura
                    </div>
                    <h4 class="mb-0">
                        @Model.OpeningAmount.ToString("C2")
                    </h4>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">
                        <i class="bi bi-cart-check me-1"></i> Total vendido
                    </div>
                    <h4 class="mb-0 text-success">
                        @Model.TotalSales.ToString("C2")
                    </h4>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">
                        <i class="bi bi-arrow-down-circle me-1"></i> Suprimentos
                    </div>
                    <h4 class="mb-0 text-success">
                        @Model.CashMovements.Where(c => c.CashMovementType == CashMovementTypeEnum.CashInflows).Sum(c => c.Amount).ToString("C2")
                    </h4>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">
                        <i class="bi bi-arrow-up-circle me-1"></i> Sangrias e despesas
                    </div>
                    <h4 class="mb-0 text-danger">
                        @Model.CashMovements.Where(c => c.CashMovementType != CashMovementTypeEnum.CashInflows).Sum(c => c.Amount).ToString("C2")
                    </h4>
                </div>
            </div>
        </div>

    </div>

    <!-- Informações da sessão -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h6 class="mb-0">
                <i class="bi bi-info-circle me-2"></i> Informações da sessão
            </h6>
        </div>

        <div class="card-body">
            <div class="row g-4">

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="text-muted small">Aberto por</div>
                    <div class="fw-semibold">
                        @Model.OpenedByUser?.Name
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="text-muted small">Data de abertura</div>
                    <div class="fw-semibold">
                        @Model.OpenedAt.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="text-muted small">Fechado por</div>
                    <div class="fw-semibold">
                        @(Model.ClosedByUser?.Name ?? "—")
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="text-muted small">Data de fechamento</div>
                    <div class="fw-semibold">
                        @(Model.ClosedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Não fechado")
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="text-muted small">Última alteração por</div>
                    <div class="fw-semibold">
                        @(Model.ChangedByUser?.Name ?? "—")
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Fechamento -->
    @if (Model.CashClosing != null)
    {
        <div class="card border-0 shadow-sm mb-4">

            <div class="card-header bg-white py-3">
                <h6 class="mb-0">
                    <i class="bi bi-calculator me-2"></i> Fechamento do caixa
                </h6>
            </div>

            <div class="card-body">

                <div class="row g-3 mb-4">

                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small">Dinheiro</div>
                            <h5 class="mb-0">@Model.CashClosing.CashAmount.ToString("C2")</h5>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small">Crédito</div>
                            <h5 class="mb-0">@Model.CashClosing.TotalCredit.ToString("C2")</h5>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small">Débito</div>
                            <h5 class="mb-0">@Model.CashClosing.TotalDebit.ToString("C2")</h5>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small">Pix</div>
                            <h5 class="mb-0">@Model.CashClosing.TotalPix.ToString("C2")</h5>
                        </div>
                    </div>

                </div>

                <div class="row g-3 align-items-stretch">

                    <div class="col-12 col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">Total informado no fechamento</div>
                            <h4 class="mb-0">
                                @Model.CashClosing.ClosingTotalSales.ToString("C2")
                            </h4>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">Diferença em relação à abertura</div>
                            <h4 class="mb-0 @(closingBalance >= 0 ? "text-success" : "text-danger")">
                                @closingBalance?.ToString("C2")
                            </h4>
                        </div>
                    </div>

                </div>

                @if (!string.IsNullOrWhiteSpace(Model.CashClosing.Notes))
                {
                    <div class="mt-3">
                        <div class="text-muted small mb-1">Observações</div>
                        <div class="border rounded p-3">
                            @Model.CashClosing.Notes
                        </div>
                    </div>
                }

            </div>
        </div>
    }

    <!-- Fechamentos das maquininhas -->
    <div class="border-top pt-4 mb-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="mb-0">
                <i class="bi bi-credit-card me-2"></i> Fechamento das maquininhas
            </h6>

            <span class="badge bg-light text-dark">
                @Model.CashClosingTerminals.Count terminais
            </span>
        </div>

        @if (Model.CashClosingTerminals.Any())
        {
            <!-- Desktop -->
            <div class="table-responsive d-none d-md-block">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Terminal</th>
                            <th>Fechado em</th>
                            <th>Responsável</th>
                            <th class="text-end">Crédito</th>
                            <th class="text-end">Débito</th>
                            <th class="text-end">Pix</th>
                            <th class="text-end pe-3">Total</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var terminal in Model.CashClosingTerminals)
                        {
                            var terminalTotal = terminal.CreditAmount + terminal.DebitAmount + terminal.PixAmount;

                            <tr>
                                <td class="ps-3">
                                    <div class="fw-semibold">
                                        @terminal.PaymentTerminal?.Name
                                    </div>
                                </td>

                                <td class="text-nowrap">
                                    @(terminal.ClosedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                                </td>

                                <td>
                                    @(terminal.CreatedByUser?.Name ?? "—")
                                </td>

                                <td class="text-end text-nowrap">
                                    @terminal.CreditAmount.ToString("C2")
                                </td>

                                <td class="text-end text-nowrap">
                                    @terminal.DebitAmount.ToString("C2")
                                </td>

                                <td class="text-end text-nowrap">
                                    @terminal.PixAmount.ToString("C2")
                                </td>

                                <td class="text-end pe-3 fw-semibold text-nowrap">
                                    @terminalTotal.ToString("C2")
                                </td>
                            </tr>
                        }
                    </tbody>

                    <tfoot class="table-light">
                        <tr class="fw-semibold">
                            <td colspan="3" class="ps-3">Total dos terminais</td>

                            <td class="text-end">
                                @terminalCreditTotal.ToString("C2")
                            </td>

                            <td class="text-end">
                                @terminalDebitTotal.ToString("C2")
                            </td>

                            <td class="text-end">
                                @terminalPixTotal.ToString("C2")
                            </td>

                            <td class="text-end pe-3">
                                @terminalGrandTotal.ToString("C2")
                            </td>
                        </tr>
                    </tfoot>

                </table>
            </div>

            <!-- Mobile -->
            <div class="d-md-none d-flex flex-column gap-3">

                @foreach (var terminal in Model.CashClosingTerminals)
                {
                    var terminalTotal = terminal.CreditAmount + terminal.DebitAmount + terminal.PixAmount;

                    <div class="cash-history-card">

                        <div class="d-flex align-items-center gap-2 mb-3">
                            <div class="bg-white rounded-3 p-2 text-primary">
                                <i class="bi bi-credit-card fs-5"></i>
                            </div>

                            <div>
                                <div class="fw-bold">
                                    @terminal.PaymentTerminal?.Name
                                </div>
                                <small class="text-muted">
                                    @(terminal.ClosedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Não informado")
                                </small>
                            </div>
                        </div>

                        <div class="cash-history-info mb-3">
                            <div class="info-label">Responsável</div>
                            <div class="fw-semibold">
                                @(terminal.CreatedByUser?.Name ?? "—")
                            </div>
                        </div>

                        <div class="row g-2">
                            <div class="col-6">
                                <div class="cash-history-info">
                                    <div class="info-label">Crédito</div>
                                    <div class="fw-semibold">
                                        @terminal.CreditAmount.ToString("C2")
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="cash-history-info">
                                    <div class="info-label">Débito</div>
                                    <div class="fw-semibold">
                                        @terminal.DebitAmount.ToString("C2")
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="cash-history-info">
                                    <div class="info-label">Pix</div>
                                    <div class="fw-semibold">
                                        @terminal.PixAmount.ToString("C2")
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="cash-history-info">
                                    <div class="info-label">Total</div>
                                    <div class="fw-bold text-primary">
                                        @terminalTotal.ToString("C2")
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                }

                <!-- Total geral dos terminais -->
                <div class="terminal-total-card">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="bg-white rounded-3 p-2 text-primary">
                            <i class="bi bi-calculator fs-5"></i>
                        </div>
                        <div>
                            <div class="fw-bold">Total de todos os terminais</div>
                            <small class="text-muted">Resumo dos valores recebidos</small>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <div class="terminal-total-info">
                                <div class="info-label">Crédito</div>
                                <div class="fw-semibold small">@terminalCreditTotal.ToString("C2")</div>
                            </div>
                        </div>

                        <div class="col-4">
                            <div class="terminal-total-info">
                                <div class="info-label">Débito</div>
                                <div class="fw-semibold small">@terminalDebitTotal.ToString("C2")</div>
                            </div>
                        </div>

                        <div class="col-4">
                            <div class="terminal-total-info">
                                <div class="info-label">Pix</div>
                                <div class="fw-semibold small">@terminalPixTotal.ToString("C2")</div>
                            </div>
                        </div>
                    </div>

                    <div class="border-top pt-3 d-flex justify-content-between align-items-center gap-2">
                        <span class="fw-semibold">Total geral</span>
                        <span class="fw-bold fs-4 text-primary">@terminalGrandTotal.ToString("C2")</span>
                    </div>
                </div>

            </div>
        }
        else
        {
            <div class="text-center py-4 bg-light rounded">
                <i class="bi bi-credit-card fs-3 text-muted"></i>
                <p class="text-muted mt-2 mb-0">
                    Nenhum fechamento de terminal registrado.
                </p>
            </div>
        }

    </div>

    <!-- Histórico de movimentações -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white py-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h6 class="mb-0">
                    <i class="bi bi-arrow-left-right me-2"></i> Histórico de movimentações
                </h6>
                <span class="badge bg-light text-dark">
                    @Model.CashMovements.Count movimentações
                </span>
            </div>
        </div>

        <div class="card-body">

            <!-- Resumo por tipo de movimentação -->
            <div class="row g-3 mb-4">

                <div class="col-12 col-sm-4">
                    <div class="movement-summary-card">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="movement-summary-icon bg-success-subtle text-success">
                                <i class="bi bi-arrow-down-circle"></i>
                            </div>
                            <span class="text-muted small fw-semibold">Suprimentos</span>
                        </div>
                        <div class="fs-5 fw-bold text-success">
                            @supplyTotal.ToString("C2")
                        </div>
                        <small class="text-muted">
                            @supplyMovements.Count movimentações
                        </small>
                    </div>
                </div>

                <div class="col-12 col-sm-4">
                    <div class="movement-summary-card">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="movement-summary-icon bg-danger-subtle text-danger">
                                <i class="bi bi-arrow-up-circle"></i>
                            </div>
                            <span class="text-muted small fw-semibold">Sangrias</span>
                        </div>
                        <div class="fs-5 fw-bold text-danger">
                            @withdrawalTotal.ToString("C2")
                        </div>
                        <small class="text-muted">
                            @withdrawalMovements.Count movimentações
                        </small>
                    </div>
                </div>

                <div class="col-12 col-sm-4">
                    <div class="movement-summary-card">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="movement-summary-icon bg-warning-subtle text-warning-emphasis">
                                <i class="bi bi-receipt"></i>
                            </div>
                            <span class="text-muted small fw-semibold">Despesas</span>
                        </div>
                        <div class="fs-5 fw-bold text-danger">
                            @expenseTotal.ToString("C2")
                        </div>
                        <small class="text-muted">
                            @expenseMovements.Count movimentações
                        </small>
                    </div>
                </div>

            </div>

            @if (Model.CashMovements.Any())
            {
                <!-- Desktop -->
                <div class="table-responsive d-none d-md-block">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Data/Hora</th>
                                <th>Tipo</th>
                                <th>Descrição</th>
                                <th>Responsável</th>
                                <th class="text-end pe-3">Valor</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var movement in Model.CashMovements.OrderByDescending(x => x.OccurredAt))
                            {
                                <tr>
                                    <td class="ps-3 text-nowrap">
                                        @movement.OccurredAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        <span class="fw-semibold @MovementClass(movement.CashMovementType)">
                                            @MovementLabel(movement.CashMovementType)
                                        </span>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(movement.Description) ? "—" : movement.Description)
                                    </td>

                                    <td>
                                        @movement.CreatedByUser?.Name
                                    </td>

                                    <td class="text-end pe-3 fw-semibold text-nowrap">
                                        @movement.Amount.ToString("C2")
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

                <!-- Mobile -->
                <div class="d-md-none d-flex flex-column gap-3">
                    @foreach (var movement in Model.CashMovements.OrderByDescending(x => x.OccurredAt))
                    {
                        <div class="cash-history-card">

                            <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                                <div>
                                    <div class="fw-semibold">
                                        @movement.OccurredAt.ToString("dd/MM/yyyy")
                                    </div>
                                    <small class="text-muted">
                                        @movement.OccurredAt.ToString("HH:mm")
                                    </small>
                                </div>

                                <span class="badge rounded-pill @MovementBadgeClass(movement.CashMovementType)">
                                    @MovementLabel(movement.CashMovementType)
                                </span>
                            </div>

                            <div class="cash-history-info mb-3">
                                <div class="info-label">Descrição</div>
                                <div class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(movement.Description) ? "—" : movement.Description)
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="info-label">Responsável</div>
                                    <div class="small fw-semibold">
                                        @(movement.CreatedByUser?.Name ?? "—")
                                    </div>
                                </div>

                                <div class="text-end">
                                    <div class="info-label">Valor</div>
                                    <div class="fw-bold fs-5 @MovementClass(movement.CashMovementType)">
                                        @movement.Amount.ToString("C2")
                                    </div>
                                </div>
                            </div>

                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox fs-1 text-muted"></i>
                    <p class="text-muted mt-2 mb-0">
                        Nenhuma movimentação registrada nesta sessão.
                    </p>
                </div>
            }

        </div>
    </div>

</div>
