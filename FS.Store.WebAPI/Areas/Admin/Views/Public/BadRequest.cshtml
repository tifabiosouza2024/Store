@{
    ViewData["Title"] = "Requisição inválida";
    Layout = "_PublicLayout";
    var message = Context.Request.Query["message"].ToString();
}

<div class="container d-flex align-items-center justify-content-center min-vh-100 py-5">
    <div class="text-center" style="max-width: 520px;">

        <div class="mb-4">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10"
                 style="width: 120px; height: 120px;">
                <i class="bi bi-exclamation-triangle text-danger" style="font-size: 4rem;"></i>
            </div>
        </div>

        <div class="mb-3">
            <span class="badge rounded-pill text-bg-danger px-3 py-2">
                Erro 400
            </span>
        </div>

        <h1 class="fw-bold mb-3">Requisição inválida</h1>
        @if (User.GetOperationId() == Guid.Empty)
        {
            <h3>Você não selecionou uma operação. <a asp-action="Index" asp-controller="Home" asp-area="Admin">Clique aqui</a> para escolher a operação desejada antes de continuar.</h3>
        }
        @if (message.IsNotNullOrEmpty())
        {
            <h3>@message</h3>
        }

        <p class="text-secondary fs-5 mb-4">
            Não foi possível processar sua solicitação, pois os dados enviados são inválidos
            ou a requisição não está em um formato esperado.
            Verifique as informações e tente novamente.
        </p>

        <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
            <a asp-area="Admin" asp-controller="CashSession" asp-action="Index" class="btn btn-primary btn-lg px-4">
                <i class="bi bi-house-door me-2"></i>
                Ir para o painel
            </a>

            <button type="button" class="btn btn-outline-secondary btn-lg px-4" onclick="history.back()">
                <i class="bi bi-arrow-left me-2"></i>
                Voltar
            </button>
        </div>

        <div class="mt-5 text-secondary small">
            <i class="bi bi-info-circle me-1"></i>
            Se o problema persistir, verifique os dados informados ou tente novamente mais tarde.
        </div>

    </div>
</div>
