@model OperationCreateViewModel

@{
    ViewData["Title"] = "Nova Operação";
}

<form asp-action="Create" method="post" id="operation-form">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0"><i class="bi bi-building me-2"></i>Dados da Operação</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Document" class="form-label">CNPJ</label>
                    <input asp-for="Document" class="form-control cnpj" placeholder="00.000.000/0000-00" maxlength="18" />
                    <span asp-validation-for="Document" class="text-danger"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="Name" class="form-label">Nome da Operação</label>
                    <input asp-for="Name" class="form-control" placeholder="Nome da empresa ou operação" maxlength="255" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">E-mail da Operação</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="contato@empresa.com.br" maxlength="255" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                    <div class="form-text">E-mail de contato da empresa.</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0"><i class="bi bi-person-badge me-2"></i>Gestor da Operação</h5>
        </div>
        <div class="card-body">
            <div class="alert alert-info d-flex align-items-start gap-2">
                <i class="bi bi-info-circle fs-5"></i>
                <div>
                    <strong>Acesso inicial do gestor</strong>
                    <div class="small">Informe o e-mail e defina uma senha provisória para o primeiro acesso à operação. Futuramente, o gestor poderá receber um convite por e-mail para completar seu cadastro e definir uma nova senha.</div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="ManagerEmail" class="form-label">E-mail do Gestor</label>
                    <input asp-for="ManagerEmail" type="email" class="form-control" placeholder="gestor@empresa.com.br" maxlength="255" autocomplete="off" />
                    <span asp-validation-for="ManagerEmail" class="text-danger"></span>
                    <div class="form-text">Será utilizado para identificar o usuário responsável pelo acesso.</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label">Senha Provisória</label>
                    <div class="input-group">
                        <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                        <button type="button" class="btn btn-outline-secondary account-toggle-password" data-target="Password" aria-label="Mostrar senha" tabindex="-1">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label">Confirmar Senha</label>
                    <div class="input-group">
                        <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                        <button type="button" class="btn btn-outline-secondary account-toggle-password" data-target="ConfirmPassword" aria-label="Mostrar senha" tabindex="-1">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Voltar
        </a>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i> Cadastrar Operação
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="text/javascript" src="~/js/admin/change-password.js" asp-append-version="true"></script>
}