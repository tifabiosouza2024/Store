                                        <path d="M196.142,94.063h-51.307c-4.427,0-8.017,3.589-8.017,8.017s3.589,8.017,8.017,8.017h51.307c4.427,0,8.017-3.589,8.017-8.017S200.569,94.063,196.142,94.063z"></path>
