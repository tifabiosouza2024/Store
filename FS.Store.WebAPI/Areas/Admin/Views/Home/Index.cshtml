@model HomeViewModel

@{
    ViewData["Title"] = "Início";

    bool isSuper = User.IsSuper();
    var operationRoles = Model.OperationRoles.ToList();
    var hasOperation = User.GetOperationId() is Guid operationId && operationId != Guid.Empty;
    var hasCashSession = Model.CashSessionId != null;
    var currentOperation = operationRoles.FirstOrDefault(x => x.OperationId == Model.OperationId);
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/home-index.css" asp-append-version="true" />
}

<div class="dashboard">

    <!-- Cabeçalho -->
    <section class="dashboard-welcome">
        <div class="welcome-content">
            <span class="welcome-eyebrow">
                <i class="bi bi-grid-1x2"></i>
                GESTÃO DE LOJA
            </span>

            <h1>Olá, @User.Identity?.Name!</h1>

            <p>Bem-vindo ao seu painel de gerenciamento. Acesse suas operações e gerencie sua loja.</p>

            @if (hasOperation)
            {
                <div class="welcome-status">
                    <span class="status-indicator"></span>
                    <span>Você está conectado ao sistema</span>
                </div>
            }
        </div>

        <div class="welcome-illustration">
            <i class="bi bi-shop-window"></i>
            <span class="illustration-decoration decoration-one"></span>
            <span class="illustration-decoration decoration-two"></span>
        </div>
    </section>

    <!-- Convites -->
    @if (Model.QttInvite > 0)
    {
        <section class="invite-banner">
            <div class="invite-icon">
                <i class="bi bi-envelope-paper"></i>
            </div>

            <div class="invite-content">
                <span class="invite-label">CONVITE PENDENTE</span>
                @if (Model.QttInvite > 1)
                {
                    <h2>Você foi convidado para uma operação!</h2>
                }
                else
                {
                    <h2>Você foi convidado para uma operação!</h2>
                }
                <p>Confira os detalhes do convite e escolha se deseja fazer parte dessa operação.</p>
            </div>

            <a asp-action="ViewInvite" class="invite-action">
                Visualizar convite
                <i class="bi bi-arrow-right"></i>
            </a>
        </section>
    }
    @if (User.IsSuper())
    {
        <section class="cash-highlight">
            <div class="cash-highlight-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" height="24px" width="24px" fill="currentcolor"><path d="M18.48,21.91q-0.18-0.06-0.32-0.21l-5.1-5.1q-0.15-0.15-0.21-0.33T12.78,15.9t0.06-0.38t0.21-0.33l2.13-2.13q0.15-0.15 0.32-0.21t0.38-0.06t0.38,0.06t0.32,0.21l5.1,5.1q0.15,0.15 0.21,0.32t0.06,0.38t-0.06,0.38t-0.21,0.32L19.55,21.7q-0.15,0.15-0.32,0.21t-0.38,0.06t-0.38-0.06Zm0.38-2.31l0.73-0.73L15.9,15.2l-0.72,0.72l3.68,3.68ZM4.74,21.93Q4.55,21.85 4.4,21.7L2.3,19.6q-0.15-0.15-0.23-0.34T2,18.88T2.08,18.5T2.3,18.18l5.3-5.3H9.73l0.85-0.85L6.45,7.9H5.03L2,4.88L4.83,2.05L7.85,5.07V6.5l4.13,4.13l2.9-2.9L13.8,6.65l1.4-1.4H12.38l-0.7-0.7L15.23,1l0.7,0.7V4.52l1.4-1.4l3.55,3.55Q21.3,7.1 21.53,7.64q0.22,0.54 0.22,1.14q0,0.6-0.22,1.15q-0.23,0.55-0.65,0.97L18.75,8.77l-1.4,1.4L16.3,9.13L11.13,14.3v2.1l-5.3,5.3Q5.68,21.85 5.5,21.93Q5.33,22 5.13,22T4.74,21.93ZM5.13,19.6l4.25-4.25V14.63H8.65L4.4,18.88L5.13,19.6Zm0,0L4.4,18.88l0.38,0.35L5.13,19.6Zm13.73,0l0.73-0.73L18.85,19.6Z" /></svg>
            </div>

            <div class="cash-highlight-content">
                <span>SUPER-USUÁRIO</span>
                <h2>Você está conectado como Super-Usuário e poderá realizar alterações globais no sistema.</h2>
            </div>
        </section>
    }
    <!-- Seleção de operação -->
    @if (operationRoles.Any() || Model.QttInvite > 0)
    {
        <section class="dashboard-section operation-section">

            @if (operationRoles.Any())
            {
                <div class="dashboard-title">
                    <div>
                        <span class="section-eyebrow">AMBIENTE DE TRABALHO</span>
                        <h2>Sua operação</h2>
                        @if (!User.AnyOperation())
                        {
                            if (operationRoles.Count() > 1)
                            {
                                <p><b>Selecione uma das operações abaixo para iniciar seu trabalho.</b></p>
                            }
                            else
                            {
                                <p><b>Selecione a operação abaixo para iniciar seu trabalho.</b></p>
                            }
                        }
                    </div>

                    <div class="section-title-icon">
                        <i class="bi bi-shop"></i>
                    </div>
                </div>

                <form asp-action="ChangeOperation" method="post" id="operationForm">
                    @Html.AntiForgeryToken()

                    <div class="operation-grid">

                        @foreach (var operation in operationRoles)
                        {
                            var isCurrent = operation.OperationId == Model.OperationId;

                            <button type="submit"
                                    name="OperationId"
                                    value="@(isCurrent ? "" : operation.OperationId.ToString())"
                                    class="operation-card @(isCurrent ? "selected" : "")"
                                    aria-current="@(isCurrent ? "true" : null)"
                                    title="@(isCurrent ? "Sair desta operação" : $"Acessar {operation.Operation.Name}")">

                                <span class="operation-card-top">
                                    <span class="operation-card-icon">
                                        <i class="bi bi-shop-window"></i>
                                    </span>

                                    @if (isCurrent)
                                    {
                                        <span class="operation-current-badge">
                                            <i class="bi bi-check-circle-fill"></i>
                                            Atual
                                        </span>

                                        <span class="operation-exit-icon">
                                            <i class="bi bi-box-arrow-right"></i>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="operation-access-icon">
                                            <i class="bi bi-arrow-up-right"></i>
                                        </span>
                                    }
                                </span>

                                <span class="operation-card-content">
                                    <strong>@operation.Operation.Name</strong>
                                    <small>
                                        <i class="bi bi-person-badge"></i>
                                        @operation.Role.Name
                                    </small>
                                </span>

                                <span class="operation-card-footer">
                                    @(isCurrent ? "Sair desta operação" : "Acessar esta operação")
                                </span>
                            </button>
                        }

                    </div>
                </form>
            }
            else if (Model.QttInvite == 0)
            {
                <div class="operation-empty">
                    <div class="operation-empty-icon">
                        <i class="bi bi-shop"></i>
                    </div>

                    <div>
                        <h3>Nenhuma operação vinculada</h3>
                        <p>Para utilizar o sistema, é necessário fazer parte de uma operação. Aguarde um convite de um administrador.</p>
                    </div>
                </div>
            }
        </section>
    }
    <!-- Caixa atual -->
    @if (hasOperation && hasCashSession)
    {
        <section class="cash-highlight">
            <div class="cash-highlight-icon">
                <i class="bi bi-wallet2"></i>
            </div>

            <div class="cash-highlight-content">
                <span>SESSÃO DE CAIXA EM ANDAMENTO</span>
                <h2>Seu caixa está aberto</h2>
                <p>Você possui uma sessão de caixa ativa. Acesse as movimentações ou realize o fechamento.</p>
            </div>

            <a asp-area="Admin"
               asp-controller="CashMovement"
               asp-action="Index"
               asp-route-cashSessionId="@Model.CashSessionId"
               class="cash-highlight-action">
                Acessar caixa
                <i class="bi bi-arrow-right"></i>
            </a>
        </section>
    }

    <!-- Acesso rápido -->
    @if (hasOperation || isSuper)
    {
        <section class="dashboard-section shortcuts-section">

            <div class="dashboard-title">
                <div>
                    <span class="section-eyebrow">FUNCIONALIDADES</span>
                    <h2>Acesso rápido</h2>
                    <p>Encontre rapidamente as ferramentas que você precisa.</p>
                </div>

                <div class="section-title-icon">
                    <i class="bi bi-lightning-charge"></i>
                </div>
            </div>

            <div class="shortcut-grid">

                @if (hasOperation)
                {
                    <!-- Caixa -->
                    <a asp-area="Admin" asp-controller="CashSession" asp-action="Index" class="shortcut-card">
                        <span class="shortcut-icon shortcut-purple">
                            <i class="bi bi-wallet2"></i>
                        </span>
                        <span class="shortcut-category">CAIXA</span>
                        <strong>Caixas abertos</strong>
                        <span>Consulte as sessões de caixa em andamento.</span>
                        <i class="bi bi-arrow-up-right shortcut-arrow"></i>
                    </a>

                    <a asp-area="Admin" asp-controller="CashSession" asp-action="Open" class="shortcut-card">
                        <span class="shortcut-icon shortcut-green">
                            <i class="bi bi-plus-circle"></i>
                        </span>
                        <span class="shortcut-category">CAIXA</span>
                        <strong>Abertura de caixa</strong>
                        <span>Inicie uma nova sessão de caixa.</span>
                        <i class="bi bi-arrow-up-right shortcut-arrow"></i>
                    </a>

                    @if (hasCashSession)
                    {
                        <a asp-area="Admin" asp-controller="CashMovement" asp-action="Index" asp-route-cashSessionId="@Model.CashSessionId" class="shortcut-card">
                            <span class="shortcut-icon shortcut-blue">
                                <i class="bi bi-arrow-left-right"></i>
                            </span>
                            <span class="shortcut-category">MOVIMENTAÇÕES</span>
                            <strong>Todas as movimentações</strong>
                            <span>Consulte todas as entradas e saídas do caixa.</span>
                            <i class="bi bi-arrow-up-right shortcut-arrow"></i>
                        </a>

                        <a asp-area="Admin" asp-controller="CashMovement" asp-action="Supply" asp-route-cashSessionId="@Model.CashSessionId" class="shortcut-card">
                            <span class="shortcut-icon shortcut-green">
                                <i class="bi bi-cash-coin"></i>
                            </span>
                            <span class="shortcut-category">MOVIMENTAÇÕES</span>
                            <strong>Suprimento</strong>
                            <span>Registre a entrada de dinheiro no caixa.</span>
                            <i class="bi bi-arrow-up-right shortcut-arrow"></i>
                        </a>

                        <a asp-area="Admin" asp-controller="CashMovement" asp-action="Withdrawal" asp-route-cashSessionId="@Model.CashSessionId" class="shortcut-card">
                            <span class="shortcut-icon shortcut-orange">
                                <i class="bi bi-box-arrow-up-right"></i>
                            </span>
                            <span class="shortcut-category">MOVIMENTAÇÕES</span>
                            <strong>Sangria</strong>
                            <span>Registre a retirada de dinheiro do caixa.</span>
                            <i class="bi bi-arrow-up-right shortcut-arrow"></i>
                        </a>

                        <a asp-area="Admin" asp-controller="CashMovement" asp-action="Expense" asp-route-cashSessionId="@Model.CashSessionId" class="shortcut-card">
                            <span class="shortcut-icon shortcut-red">
                                <i class="bi bi-receipt"></i>
                            </span>
                            <span class="shortcut-category">MOVIMENTAÇÕES</span>
                            <strong>Despesas</strong>
                            <span>Registre as despesas do caixa.</span>
                            <i class="bi bi-arrow-up-right shortcut-arrow"></i>
                        </a>

                        <a asp-area="Admin" asp-controller="CashSession" asp-action="Close" asp-route-Id="@Model.CashSessionId" class="shortcut-card">
                            <span class="shortcut-icon shortcut-orange">
                                <i class="bi bi-lock"></i>
                            </span>
                            <span class="shortcut-category">CAIXA</span>
                            <strong>Fechamento de Caixa</strong>
                            <span>Realize o fechamento de caixa.</span>
                            <i class="bi bi-arrow-up-right shortcut-arrow"></i>
                        </a>

                        @if (User.IsManagerOrGreater())
                        {
                            <a asp-area="Admin" asp-controller="CashSession" asp-action="Edit" asp-route-Id="@Model.CashSessionId" class="shortcut-card">
                                <span class="shortcut-icon shortcut-blue">
                                    <i class="bi bi-pencil-square"></i>
                                </span>
                                <span class="shortcut-category">CAIXA</span>
                                <strong>Editar sessão</strong>
                                <span>Altere os dados da sessão do caixa.</span>
                                <i class="bi bi-arrow-up-right shortcut-arrow"></i>
                            </a>
                        }
                    }

                    <!-- Administração -->
                    @if (User.IsManagerOrGreater())
                    {
                        <a asp-area="Admin" asp-controller="PaymentTerminal" asp-action="Index" class="shortcut-card">
                            <span class="shortcut-icon shortcut-red">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 512 512" fill="currentColor" style="display: block; flex-shrink: 0;">

                                    <g fill="currentColor">
