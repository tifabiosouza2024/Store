@{
    var year = DateTime.Now.Year;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Gestor de Loja</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FS.Store.styles.css" asp-append-version="true" />
</head>

<body>

    <div class="app-shell">

        @if (isAuthenticated)
        {
            <!-- Menu lateral -->
            <aside class="offcanvas-lg offcanvas-start sidebar" tabindex="-1" id="adminSidebar" aria-labelledby="sidebarTitle">

                <div class="sidebar-brand">
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="brand-link">
                        <span class="brand-icon">
                            <i class="bi bi-shop"></i>
                        </span>

                        <span>
                            <strong id="sidebarTitle">Gestor de Loja</strong>
                            <small>Gestão da loja</small>
                        </span>
                    </a>

                    <button type="button" class="btn-close d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar" aria-label="Fechar menu"></button>
                </div>

                <div class="sidebar-content">
                    <div class="menu-caption">MENU PRINCIPAL</div>
                    <nav class="nav flex-column sidebar-nav">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="nav-link">
                            <i class="bi bi-grid-1x2"></i>
                            <span>Painel inicial</span>
                        </a>

                        <button class="nav-link sidebar-menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#cashSubmenu" aria-expanded="" aria-controls="cashSubmenu">
                            <i class="bi bi-wallet2"></i>
                            <span class="flex-grow-1 text-start">Caixa</span>
                            <i class="bi bi-chevron-down submenu-chevron"></i>
                        </button>

                        <div class="collapse" id="cashSubmenu">
                            <nav class="nav flex-column sidebar-subnav">
                                <a asp-area="Admin" asp-controller="CashSession" asp-action="Open" class="nav-link">
                                    <i class="bi bi-circle-plus"></i>
                                    <span>Abertura de caixa</span>
                                </a>
                                <a asp-area="Admin" asp-controller="CashMovement" asp-action="Index" class="nav-link">
                                    <i class="bi bi-arrow-left-right"></i>
                                    <span>Movimentações</span>
                                </a>
                                <a asp-area="Admin" asp-controller="CashMovement" asp-action="Supply" class="nav-link">
                                    <i class="bi bi-plus-circle"></i>
                                    <span>Suprimento</span>
                                </a>
                                <a asp-area="Admin" asp-controller="CashMovement" asp-action="Withdrawal" class="nav-link">
                                    <i class="bi bi-dash-circle"></i>
                                    <span>Sangria</span>
                                </a>
                                <a asp-area="Admin" asp-controller="CashSession" asp-action="Close" class="nav-link">
                                    <i class="bi bi-clipboard-check"></i>
                                    <span>Fechamento de caixa</span>
                                </a>
                                <a asp-area="Admin" asp-controller="CashSession" asp-action="History" class="nav-link">
                                    <i class="bi bi-clock-history"></i>
                                    <span>Histórico de caixas</span>
                                </a>
                            </nav>
                        </div>
                    </nav>
                </div>

                <div class="sidebar-footer">
                    <span class="status-indicator"></span>
                    <span>Sistema operacional</span>
                </div>
            </aside>
        }

        <!-- Área principal -->
        <div class="main-panel">
            <header class="topbar">
                <div class="topbar-left">
                    @if (isAuthenticated)
                    {
                        <button class="btn menu-toggle d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar" aria-label="Abrir menu">
                            <i class="bi bi-list"></i>
                        </button>
                    }

                    <div class="page-heading">
                        <span class="page-eyebrow">
                            ADMINISTRAÇÃO
                        </span>
                        <h1>@ViewData["Title"]</h1>
                    </div>
                </div>

                @if (isAuthenticated)
                {
                    <div class="topbar-user">
                        <div class="user-avatar">
                            <i class="bi bi-person"></i>
                        </div>

                        <div class="user-details">
                            <strong>@(User.Identity?.Name ?? "Usuário")</strong>
                            <small>Usuário autenticado</small>
                        </div>

                        <form asp-area="Admin" asp-controller="Public" asp-action="Logout" method="post" class="ms-2">
                            <button type="submit" class="btn btn-logout" title="Sair" aria-label="Sair">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </form>
                    </div>
                }
            </header>

            <main class="page-content" role="main">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>© @(year == 2026 ? year : $"2026 - {year}") FS.Store</span>
                <span>Gestão simples, operação eficiente.</span>
            </footer>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/admin/menu.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
