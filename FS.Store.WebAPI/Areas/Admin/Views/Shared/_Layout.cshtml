@{
    var year = DateTime.Now.Year;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Gestor de Loja</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/float-buttons.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <div class="app-shell">

        @if (isAuthenticated)
        {
            @await Component.InvokeAsync("AdminSidebar")
        }

        <!-- Área principal -->
        <div class="main-panel">
            <header class="topbar">
                <div class="topbar-left">
                    @if (isAuthenticated)
                    {
                        <button class="btn menu-toggle d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar" aria-label="Abrir menu">
                            <i class="bi bi-list"></i>
                        </button>
                    }

                    <div class="page-heading">
                        <span class="page-eyebrow">
                            ADMINISTRAÇÃO
                        </span>
                        <h1>@ViewData["Title"]</h1>
                    </div>
                </div>

                @if (isAuthenticated)
                {
                    <div class="topbar-user">
                        <div class="user-avatar">
                            <i class="bi bi-person"></i>
                        </div>

                        <div class="user-details">
                            <strong>@(User.Identity?.Name ?? "Usuário")</strong>
                            <small>Usuário autenticado</small>
                        </div>

                        <form asp-area="Admin" asp-controller="Public" asp-action="Logout" method="post" class="ms-2">
                            <button type="submit" class="btn btn-logout" title="Sair" aria-label="Sair">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </form>
                    </div>
                }
            </header>

            <main class="page-content" role="main">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>© @(year == 2026 ? year : $"2026 - {year}") FS.Store</span>
                <span>Gestão simples, operação eficiente.</span>
            </footer>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/price-mask.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/admin/menu.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
