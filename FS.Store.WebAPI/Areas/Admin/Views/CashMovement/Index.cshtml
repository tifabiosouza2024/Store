                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Histórico -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                <h5 class="mb-0">
                    Histórico de movimentações
                </h5>

                <form asp-action="Index"
                      method="get"
                      class="d-flex gap-2">

                    <select name="type"
                            class="form-select form-select-sm"
                            onchange="this.form.submit()">

                        <option value="">Todas as movimentações</option>

                        @foreach (CashMovementTypeEnum type in Enum.GetValues(typeof(CashMovementTypeEnum)))
                        {
                            <option value="@type"
                                    selected="@(Context.Request.Query["type"] == type.ToString())">
                                @type
                            </option>
                        }

                    </select>

                </form>

            </div>

        </div>

        <div class="card-body p-0">

            @if (Model.Items.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Data</th>
                                <th>Tipo</th>
                                <th>Descrição</th>
                                <th>Responsável</th>
                                <th class="text-end pe-3">Valor</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model.Items)
                            {
                                var isSupply = item.CashMovementType == CashMovementTypeEnum.CashInflows;

                                <tr>

                                    <td class="ps-3 text-nowrap">
                                        @item.OccurredAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        @if (item.CashMovementType == CashMovementTypeEnum.CashInflows)
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                <i class="bi bi-arrow-up-circle me-1"></i>
                                                Suprimento
                                            </span>
                                        }
                                        else if (item.CashMovementType == CashMovementTypeEnum.Withdrawal)
                                        {
                                            <span class="badge bg-danger-subtle text-danger">
                                                <i class="bi bi-arrow-down-circle me-1"></i>
                                                Sangria
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">
