@model CashMovementListViewModel

@{
    ViewData["Title"] = "Movimentações de Caixa";
}

<div class="container-fluid">

    <!-- Cabeçalho -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <h4 class="mb-1">
                <i class="bi bi-arrow-left-right me-2"></i>
                Movimentações de Caixa
            </h4>

            <p class="text-muted mb-0">
                Consulte as entradas e saídas realizadas no caixa.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">

            <a asp-action="Supply" asp-controller="CashMovement" asp-route-cashSessionId="@Model.CashSessionId" class="btn btn-success">
                <i class="bi bi-arrow-up-circle me-1"></i>
                Suprimento
            </a>

            <a asp-action="Withdrawal" asp-controller="CashMovement" asp-route-cashSessionId="@Model.CashSessionId" class="btn btn-outline-danger">
                <i class="bi bi-arrow-down-circle me-1"></i>
                Sangria
            </a>

            <a asp-action="Expense" asp-controller="CashMovement" asp-route-cashSessionId="@Model.CashSessionId" class="btn btn-danger">
                <svg width="24px" height="24px" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg" fill="#ffffff" stroke="#ffffff"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path fill="#ffffff" d="M298.9 24.31c-14.9.3-25.6 3.2-32.7 8.4l-97.3 52.1-54.1 73.59c-11.4 17.6-3.3 51.6 32.3 29.8l39-51.4c49.5-42.69 150.5-23.1 102.6 62.6-23.5 49.6-12.5 73.8 17.8 84l13.8-46.4c23.9-53.8 68.5-63.5 66.7-106.9l107.2 7.7-1-112.09-194.3-1.4zM244.8 127.7c-17.4-.3-34.5 6.9-46.9 17.3l-39.1 51.4c10.7 8.5 21.5 3.9 32.2-6.4 12.6 6.4 22.4-3.5 30.4-23.3 3.3-13.5 8.2-23 23.4-39zm-79.6 96c-.4 0-.9 0-1.3.1-3.3.7-7.2 4.2-9.8 12.2-2.7 8-3.3 19.4-.9 31.6 2.4 12.1 7.4 22.4 13 28.8 5.4 6.3 10.4 8.1 13.7 7.4 3.4-.6 7.2-4.2 9.8-12.1 2.7-8 3.4-19.5 1-31.6-2.5-12.2-7.5-22.5-13-28.8-4.8-5.6-9.2-7.6-12.5-7.6zm82.6 106.8c-7.9.1-17.8 2.6-27.5 7.3-11.1 5.5-19.8 13.1-24.5 20.1-4.7 6.9-5.1 12.1-3.6 15.2 1.5 3 5.9 5.9 14.3 6.3 8.4.5 19.7-1.8 30.8-7.3 11.1-5.5 19.8-13 24.5-20 4.7-6.9 5.1-12.2 3.6-15.2-1.5-3.1-5.9-5.9-14.3-6.3-1.1-.1-2.1-.1-3.3-.1zm-97.6 95.6c-4.7.1-9 .8-12.8 1.9-8.5 2.5-13.4 7-15 12.3-1.7 5.4 0 11.8 5.7 18.7 5.8 6.8 15.5 13.3 27.5 16.9 11.9 3.6 23.5 3.5 32.1.9 8.6-2.5 13.5-7 15.1-12.3 1.6-5.4 0-11.8-5.8-18.7-5.7-6.8-15.4-13.3-27.4-16.9-6.8-2-13.4-2.9-19.4-2.8z"></path></g></svg>
                Despesa
            </a>

            <a asp-action="Close" asp-controller="CashSession" asp-route-id="@Model.CashSessionId" class="btn btn-primary">
                <svg class="fs-2 text-success" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" height="24px" width="24px" fill="#ffffff"><path d="M7,8Q6.18,8 5.59,7.41T5,6V4Q5,3.17 5.59,2.59T7,2H17q0.82,0 1.41,0.59T19,4V6q0,0.82-0.59,1.41T17,8H7ZM7,6H17V4H7V6ZM4,22q-0.82,0-1.41-0.59T2,20V19H22v1q0,0.82-0.59,1.41T20,22H4ZM2,18l3.48-7.83Q5.73,9.63 6.23,9.31T7.3,9h9.4q0.58,0 1.08,0.31t0.75,0.86L22,18H2Zm6.5-2h1q0.2,0 0.35-0.15T10,15.5T9.85,15.15T9.5,15h-1q-0.2,0-0.35,0.15T8,15.5t0.15,0.35T8.5,16Zm0-2h1q0.2,0 0.35-0.15T10,13.5T9.85,13.15T9.5,13h-1q-0.2,0-0.35,0.15T8,13.5t0.15,0.35T8.5,14Zm0-2h1q0.2,0 0.35-0.15T10,11.5T9.85,11.15T9.5,11h-1q-0.2,0-0.35,0.15T8,11.5t0.15,0.35T8.5,12Zm3,4h1q0.2,0 0.35-0.15T13,15.5t-0.15-0.35T12.5,15h-1q-0.2,0-0.35,0.15T11,15.5t0.15,0.35T11.5,16Zm0-2h1q0.2,0 0.35-0.15T13,13.5t-0.15-0.35T12.5,13h-1q-0.2,0-0.35,0.15T11,13.5t0.15,0.35T11.5,14Zm0-2h1q0.2,0 0.35-0.15T13,11.5t-0.15-0.35T12.5,11h-1q-0.2,0-0.35,0.15T11,11.5t0.15,0.35T11.5,12Zm3,4h1q0.2,0 0.35-0.15T16,15.5t-0.15-0.35T15.5,15h-1q-0.2,0-0.35,0.15T14,15.5t0.15,0.35T14.5,16Zm0-2h1q0.2,0 0.35-0.15T16,13.5t-0.15-0.35T15.5,13h-1q-0.2,0-0.35,0.15T14,13.5t0.15,0.35T14.5,14Zm0-2h1q0.2,0 0.35-0.15T16,11.5t-0.15-0.35T15.5,11h-1q-0.2,0-0.35,0.15T14,11.5t0.15,0.35T14.5,12Z" /></svg>
                Fechar Caixa
            </a>

        </div>
    </div>

    <!-- Resumo financeiro -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-md">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Abertura de Caixa</small>
                            <h4 class="text-success mt-2 mb-0">
                                @Model.OpeningAmount.ToString("C2")
                            </h4>
                        </div>

                        <i class="bi bi-wallet2 fs-2 text-success"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Suprimentos</small>
                            <h4 class="text-success mt-2 mb-0">
                                @Model.TotalSupply.ToString("C2")
                            </h4>
                        </div>

                        <i class="bi bi-arrow-up-circle fs-2 text-success"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Sangria</small>
                            <h4 class="text-danger mt-2 mb-0">
                                @Model.TotalWithdrawal.ToString("C2")
                            </h4>
                        </div>
                        <i class="bi bi-arrow-down-circle fs-2 text-danger"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Despesas</small>
                            <h4 class="text-danger mt-2 mb-0">
                                @Model.TotalExpense.ToString("C2")
                            </h4>
                        </div>
                        <svg width="24px" height="24px" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg" fill="#ff0000" stroke="#ff0000"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path fill="#ff0000" d="M298.9 24.31c-14.9.3-25.6 3.2-32.7 8.4l-97.3 52.1-54.1 73.59c-11.4 17.6-3.3 51.6 32.3 29.8l39-51.4c49.5-42.69 150.5-23.1 102.6 62.6-23.5 49.6-12.5 73.8 17.8 84l13.8-46.4c23.9-53.8 68.5-63.5 66.7-106.9l107.2 7.7-1-112.09-194.3-1.4zM244.8 127.7c-17.4-.3-34.5 6.9-46.9 17.3l-39.1 51.4c10.7 8.5 21.5 3.9 32.2-6.4 12.6 6.4 22.4-3.5 30.4-23.3 3.3-13.5 8.2-23 23.4-39zm-79.6 96c-.4 0-.9 0-1.3.1-3.3.7-7.2 4.2-9.8 12.2-2.7 8-3.3 19.4-.9 31.6 2.4 12.1 7.4 22.4 13 28.8 5.4 6.3 10.4 8.1 13.7 7.4 3.4-.6 7.2-4.2 9.8-12.1 2.7-8 3.4-19.5 1-31.6-2.5-12.2-7.5-22.5-13-28.8-4.8-5.6-9.2-7.6-12.5-7.6zm82.6 106.8c-7.9.1-17.8 2.6-27.5 7.3-11.1 5.5-19.8 13.1-24.5 20.1-4.7 6.9-5.1 12.1-3.6 15.2 1.5 3 5.9 5.9 14.3 6.3 8.4.5 19.7-1.8 30.8-7.3 11.1-5.5 19.8-13 24.5-20 4.7-6.9 5.1-12.2 3.6-15.2-1.5-3.1-5.9-5.9-14.3-6.3-1.1-.1-2.1-.1-3.3-.1zm-97.6 95.6c-4.7.1-9 .8-12.8 1.9-8.5 2.5-13.4 7-15 12.3-1.7 5.4 0 11.8 5.7 18.7 5.8 6.8 15.5 13.3 27.5 16.9 11.9 3.6 23.5 3.5 32.1.9 8.6-2.5 13.5-7 15.1-12.3 1.6-5.4 0-11.8-5.8-18.7-5.7-6.8-15.4-13.3-27.4-16.9-6.8-2-13.4-2.9-19.4-2.8z"></path></g></svg>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Dinheiro Disponível no caixa</small>
                            <h4 class="mt-2 mb-0 @(Model.Balance >= 0 ? "text-success" : "text-danger")">
                                @Model.Balance.ToString("C2")
                            </h4>
                        </div>
                        <svg width="24px" height="24px" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg" fill="#198754"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path fill="#198754" d="M210.6 44.39l-7-4.39c-13.7-8.4-30.8-13.28-45.5-8.7-15.8 4.92-28.4 17.09-35 35.37l-9.4-4.84c-16.2-8.34-24.68-8.47-31.71-5.31-5.61 2.51-11.46 8.55-18.09 17.37l82.4 63.71c12.9 4.2 31.8 4.1 50.7-.8 19-4.9 37.9-14.5 51.7-27.4l31.1-76.9c-27.4-21.65-52.4-9.11-69.2 11.89zm53.1 76.51c-17 17.2-42.3 28.8-62 34-6.9 1.8-13.8 3.1-20.5 3.8-3.7 6.1-6.8 12.3-9.2 18.5 4.8 24.4 13.8 44.4 27.3 60.8l-14.4 12c-8.3-10-15.7-20.8-21.3-32.8-.9 23.2 4.3 47.2 12.8 72.2l-17.7 6c-15.6-45.6-20.9-92.3 1-136.3-7.4-.6-14.4-2-20.9-4.3l-.3-.1c-4.3 4.1-8.4 8.4-12.3 12.9-31.57 36.6-48.96 85.3-39.86 123.2 4.87 20.3 13.6 39.5 26.16 55.9 18.4-.4 35.8 0 51.6 6 7.5-.8 15.2-1.3 23.2-1.3 28.5 0 54.3 5.3 73.8 14.5 7.6 3.6 14.5 7.9 20 12.8 0-5.3.8-11 2.4-15.2-8.9-8.4-14.5-18.6-14.5-30.2 0-16.1 10.7-29.4 26.2-39 0-4.6.9-9 2.5-13.2-10.1-8.7-16.6-19.5-16.6-32.1 0-7.9 2.6-15.1 7-21.6-4.4-6.4-7-13.6-7-21.5 0-3.9.6-7.5 1.7-11-9.7-8.6-15.8-19.2-15.8-31.4 0-12.1 6-22.6 15.6-31.1-5.9-4.6-12.2-8.5-18.9-11.5zm111.4 2.3c-26 0-49.5 5.5-65.6 13.6-16.2 8.1-23.8 18.1-23.8 26.7 0 8.7 7.6 18.7 23.8 26.8 16.1 8.1 39.6 13.6 65.6 13.6 11.3 0 22-1.1 31.9-2.9v-17c13.9-2.1 25.4-5.9 32.8-10.8v17.6c12.5-3.6 24.5-16.9 24.8-27.3 0-8.6-7.6-18.6-23.8-26.7-16.2-8.1-39.6-13.6-65.7-13.6zm96.5 67.7c-3.3 3.5-7.2 6.8-11.6 9.8l.2 29c12.6-7.5 18.5-16.2 18.5-23.8 0-4.8-2.3-10-7.1-15zm-171.8 15.4c.3 8.6 7.9 18.3 23.8 26.3 16.2 8.2 39.6 13.6 65.7 13.6 16.3 0 31.6-2.2 44.7-5.8l.7-27.2c-17.2 6-37.6 9.3-59.6 9.3-28.5 0-54.4-5.7-74-15.5-.5-.2-.9-.5-1.3-.7zm2 34.8c-1.4 2.7-2 5.4-2 7.9 0 8.7 7.6 18.7 23.8 26.8 16.2 8.1 39.6 13.5 65.7 13.5 13.2 0 25.7-1.3 37-3.8v-24c-11.6 2.2-24 3.3-37 3.3-28.6 0-54.5-5.6-74.1-15.5-4.9-2.4-9.4-5.2-13.4-8.2zm174.9 0c-6.1 4.3