@model CashMovementListViewModel

@{
    ViewData["Title"] = "Movimentações de Caixa";

    var movementType = Context.Request.Query["type"].ToString();

    var movements = Model.Items
        .Where(i => string.IsNullOrWhiteSpace(movementType) ||
                    i.CashMovementType.EqualsName(movementType))
        .ToList();

    var hasMovements = movements.Count > 0;

    var summaryCards = new[]
    {
        new { Title = "Abertura de Caixa", Value = Model.OpeningAmount, Icon = "bi-wallet2", Color = "primary" },
        new { Title = "Suprimentos", Value = Model.TotalSupply, Icon = "bi-arrow-up-circle", Color = "success" },
        new { Title = "Sangria", Value = Model.TotalWithdrawal, Icon = "bi-arrow-down-circle", Color = "danger" },
        new { Title = "Despesas", Value = Model.TotalExpense, Icon = "bi-receipt", Color = "warning" },
        new { Title = "Dinheiro em Caixa", Value = Model.Balance, Icon = "bi-cash-coin", Color = Model.Balance >= 0 ? "success" : "danger" }
    };
}

@section Styles {
    <style>
        /* Resumo financeiro */
        .movement-summary-icon {
            width: 48px;
            height: 48px;
            flex-shrink: 0;
            display: grid;
            place-items: center;
            border-radius: 11px;
        }

        .movement-summary-value {
            font-size: 1.35rem;
            font-weight: 600;
        }

        /* Cabeçalho */
        .movement-header-icon {
            width: 52px;
            height: 52px;
            flex-shrink: 0;
            display: grid;
            place-items: center;
            border-radius: 12px;
        }

        /* Cards mobile */
        .movement-card {
            border: 1px solid var(--border-color);
            border-radius: 12px;
            background: white;
            transition: box-shadow .2s ease;
        }

            .movement-card:hover {
                box-shadow: 0 3px 12px rgb(0 0 0 / 5%);
            }

        .movement-card-body {
            padding: 16px;
        }

        .movement-card-value {
            padding: 13px 15px;
            background: var(--app-bg);
            border-radius: 9px;
        }

        .movement-info {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
        }

        .movement-info-icon {
            width: 36px;
            height: 36px;
            flex-shrink: 0;
            display: grid;
            place-items: center;
            border-radius: 9px;
            background: var(--app-bg);
            color: var(--text-muted);
        }

        .movement-info-content {
            min-width: 0;
        }

            .movement-info-content .value {
                font-weight: 500;
                overflow-wrap: anywhere;
            }

        /* Filtro */
        .movement-filter {
            width: 100%;
            max-width: 280px;
        }

        /* Tabela */
        .movement-table-value {
            white-space: nowrap;
            font-weight: 600;
        }

        @@media (max-width: 575.98px) {
            .movement-header-icon {
                width: 42px;
                height: 42px;
            }

                .movement-header-icon i {
                    font-size: 1.25rem !important;
                }

            .movement-summary-icon {
                width: 40px;
                height: 40px;
            }

                .movement-summary-icon i {
                    font-size: 1.15rem !important;
                }

            .movement-summary-value {
                font-size: 1.05rem;
            }

            .movement-card-body {
                padding: 14px;
            }

            .movement-filter {
                max-width: none;
            }
        }
    </style>
}

<div class="container-fluid py-4">

    @* Cabeçalho *@
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div class="d-flex align-items-center gap-3">
            <div class="movement-header-icon bg-primary bg-opacity-10 text-primary">
                <i class="bi bi-arrow-left-right fs-3"></i>
            </div>
            <div>
                <h2 class="mb-1">Movimentações de Caixa</h2>
                <p class="text-muted mb-0">
                    Consulte as entradas e saídas realizadas no caixa.
                </p>
            </div>
        </div>

        @* Ações do caixa *@
        <div class="d-flex flex-wrap align-items-center gap-2">
            <partial name="Components/Buttons/_BtnAddSupply" model="new ButtonsViewModels(Model.CashSessionId, false, true)" />
            <partial name="Components/Buttons/_BtnAddWithdrawal" model="new ButtonsViewModels(Model.CashSessionId, false, true)" />
            <partial name="Components/Buttons/_BtnAddExpense" model="new ButtonsViewModels(Model.CashSessionId, false, true)" />
            <partial name="Components/Buttons/_BtnCloseSession" model="new ButtonsViewModels(Model.CashSessionId, false, true)" />
        </div>

    </div>

    @* =========================================
       RESUMO FINANCEIRO
    ========================================= *@

    <div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3 mb-4">

        @foreach (var card in summaryCards)
        {
            <div class="col">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body d-flex align-items-center gap-2 gap-md-3">

                        <div class="movement-summary-icon bg-@card.Color bg-opacity-10 text-@card.Color">
                            <i class="bi @card.Icon fs-4"></i>
                        </div>

                        <div class="min-w-0">
                            <div class="text-muted small">
                                @card.Title
                            </div>

                            <div class="movement-summary-value text-truncate text-@card.Color">
                                @card.Value.ToString("C2")
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        }

    </div>

    @* =========================================
       HISTÓRICO DE MOVIMENTAÇÕES
    ========================================= *@

    <div class="card border-0 shadow-sm">

        @* Cabeçalho e filtro *@
        <div class="card-header bg-body border-0 px-3 px-md-4 pt-4 pb-3">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                <div>
                    <h5 class="mb-1">
                        Histórico de movimentações
                    </h5>
                    <p class="text-muted small mb-0">
                        Consulte todas as entradas e saídas deste caixa.
                    </p>
                </div>

                <form asp-action="Index" method="get" class="movement-filter">
                    <input type="hidden" name="cashSessionId" value="@Model.CashSessionId" />

                    <select name="type" class="form-select" onchange="this.form.submit()">
                        <option value="">Todas as movimentações</option>

                        @foreach (CashMovementTypeEnum type in Enum.GetValues(typeof(CashMovementTypeEnum)))
                        {
                            <option value="@type" selected="@(type.EqualsName(movementType))">
                                @type.GetDisplayName()
                            </option>
                        }
                    </select>
                </form>

            </div>

        </div>

        @if (hasMovements)
        {
            @* =========================================
               DESKTOP - TABELA
            ========================================= *@

            <div class="d-none d-lg-block">
                <div class="card-body p-0">

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Data</th>
                                    <th>Tipo</th>
                                    <th>Descrição</th>
                                    <th>Responsável</th>
                                    <th class="text-end pe-4">Valor</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in movements)
                                {
                                    var isSupply = item.CashMovementType == CashMovementTypeEnum.CashInflows;
                                    var isWithdrawal = item.CashMovementType == CashMovementTypeEnum.Withdrawal;

                                    <tr>
                                        <td class="ps-4 text-nowrap">
                                            <div class="fw-medium">
                                                @item.OccurredAt.ToString("dd/MM/yyyy")
                                            </div>
                                            <div class="text-muted small">
                                                @item.OccurredAt.ToString("HH:mm")
                                            </div>
                                        </td>

                                        <td>
                                            @if (isSupply)
                                            {
                                                <span class="badge text-bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                                    <i class="bi bi-arrow-up-circle me-1"></i>
                                                    Suprimento
                                                </span>
                                            }
                                            else if (isWithdrawal)
                                            {
                                                <span class="badge text-bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">
                                                    <i class="bi bi-arrow-down-circle me-1"></i>
                                                    Sangria
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-warning bg-opacity-10 text-warning-emphasis border border-warning border-opacity-25">
                                                    <i class="bi bi-receipt me-1"></i>
                                                    Despesa
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            @(item.Description ?? "Não informado")
                                        </td>

                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-person-circle fs-5 text-muted"></i>
                                                @(item.UserName ?? "Não informado")
                                            </div>
                                        </td>

                                        <td class="text-end pe-4 movement-table-value @(isSupply ? "text-success" : "text-danger")">
                                            @(isSupply ? "+" : "-") @item.Amount.ToString("C2")
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>

                </div>
            </div>

            @* =========================================
               MOBILE - CARDS
            ========================================= *@

            <div class="d-lg-none">
                <div class="card-body p-3">

                    <div class="d-flex flex-column gap-3">

                        @foreach (var item in movements)
                        {
                            var isSupply = item.CashMovementType == CashMovementTypeEnum.CashInflows;
                            var isWithdrawal = item.CashMovementType == CashMovementTypeEnum.Withdrawal;

                            <div class="movement-card">
                                <div class="movement-card-body">

                                    @* Identificação *@
                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-3">

                                        <div class="d-flex align-items-center gap-2">
                                            <div class="movement-info-icon">
                                                @if (isSupply)
                                                {
                                                    <i class="bi bi-arrow-up-circle text-success fs-5"></i>
                                                }
                                                else if (isWithdrawal)
                                                {
                                                    <i class="bi bi-arrow-down-circle text-danger fs-5"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-receipt text-warning fs-5"></i>
                                                }
                                            </div>

                                            <div>
                                                <div class="text-muted small mb-1">
                                                    Tipo de movimentação
                                                </div>

                                                @if (isSupply)
                                                {
                                                    <span class="badge text-bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                                        Suprimento
                                                    </span>
                                                }
                                                else if (isWithdrawal)
                                                {
                                                    <span class="badge text-bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">
                                                        Sangria
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge text-bg-warning bg-opacity-10 text-warning-emphasis border border-warning border-opacity-25">
                                                        Despesa
                                                    </span>
                                                }
                                            </div>
                                        </div>

                                    </div>

                                    @* Valor *@
                                    <div class="movement-card-value mb-3">
                                        <div class="text-muted small mb-1">
                                            Valor da movimentação
                                        </div>

                                        <div class="fs-4 fw-semibold @(isSupply ? "text-success" : "text-danger")">
                                            @(isSupply ? "+" : "-") @item.Amount.ToString("C2")
                                        </div>
                                    </div>

                                    @* Informações *@
                                    <div class="d-flex flex-column gap-3">

                                        @* Data *@
                                        <div class="movement-info">
                                            <div class="movement-info-icon">
                                                <i class="bi bi-calendar3"></i>
                                            </div>
                                            <div class="movement-info-content">
                                                <div class="text-muted small">
                                                    Data e horário
                                                </div>
                                                <div class="value">
                                                    @item.OccurredAt.ToString("dd/MM/yyyy 'às' HH:mm")
                                                </div>
                                            </div>
                                        </div>

                                        @* Descrição *@
                                        <div class="movement-info">
                                            <div class="movement-info-icon">
                                                <i class="bi bi-card-text"></i>
                                            </div>
                                            <div class="movement-info-content">
                                                <div class="text-muted small">
                                                    Descrição
                                                </div>
                                                <div class="value">
                                                    @(item.Description ?? "Não informado")
                                                </div>
                                            </div>
                                        </div>

                                        @* Responsável *@
                                        <div class="movement-info">
                                            <div class="movement-info-icon">
                                                <i class="bi bi-person-circle"></i>
                                            </div>
                                            <div class="movement-info-content">
                                                <div class="text-muted small">
                                                    Responsável
                                                </div>
                                                <div class="value">
                                                    @(item.UserName ?? "Não informado")
                                                </div>
                                            </div>
                                        </div>

                                    </div>

                                </div>
                            </div>
                        }

                    </div>

                </div>
            </div>
        }
        else
        {
            @* Estado vazio *@
            <div class="card-body text-center py-5 px-4">

                <div class="bg-body-secondary rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                     style="width: 88px; height: 88px;">
                    <i class="bi bi-inbox display-5 text-secondary"></i>
                </div>

                <h5 class="mb-2">
                    Nenhuma movimentação encontrada
                </h5>

                <p class="text-muted mx-auto mb-0" style="max-width: 420px;">
                    Não existem movimentações para o filtro selecionado.
                    Experimente selecionar outro tipo de movimentação.
                </p>

            </div>
        }

        @* Rodapé *@
        <div class="card-footer bg-body border-0 py-3 px-3 px-md-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span class="text-muted small">
                    @movements.Count movimentação(ões) exibida(s).
                </span>

                @if (!string.IsNullOrWhiteSpace(movementType))
                {
                    <a asp-action="Index" asp-route-cashSessionId="@Model.CashSessionId"
                       class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-x-circle me-1"></i>
                        Limpar filtro
                    </a>
                }
            </div>
        </div>

    </div>

</div>
