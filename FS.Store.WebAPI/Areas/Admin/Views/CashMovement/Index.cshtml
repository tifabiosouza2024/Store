@model CashMovementListViewModel

@{
    ViewData["Title"] = "Movimentações de Caixa";
}

<div class="container-fluid">

    <!-- Cabeçalho -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <h4 class="mb-1">
                <i class="bi bi-arrow-left-right me-2"></i>
                Movimentações de Caixa
            </h4>

            <p class="text-muted mb-0">
                Consulte as entradas e saídas realizadas no caixa.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">

            <a asp-action="Supply" asp-controller="CashMovement" asp-route-cashSessionId="@Model.CashSessionId" class="btn btn-success">
                <i class="bi bi-plus-circle me-1"></i>
                Suprimento
            </a>

            <a asp-action="Withdrawal" asp-controller="CashMovement" asp-route-cashSessionId="@Model.CashSessionId" class="btn btn-outline-danger">
                <i class="bi bi-dash-circle me-1"></i>
                Sangria
            </a>

            <a asp-action="Expense" asp-controller="CashMovement" asp-route-cashSessionId="@Model.CashSessionId" class="btn btn-outline-secondary">
                <i class="bi bi-receipt me-1"></i>
                Despesa
            </a>

        </div>
    </div>

    <!-- Resumo financeiro -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-md">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Abertura de Caixa</small>
                            <h4 class="text-success mt-2 mb-0">
                                @Model.OpeningAmount.ToString("C2")
                            </h4>
                        </div>

                        <i class="bi bi-arrow-down-circle fs-2 text-success"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Suprimentos</small>
                            <h4 class="text-success mt-2 mb-0">
                                @Model.TotalSupply.ToString("C2")
                            </h4>
                        </div>

                        <i class="bi bi-arrow-down-circle fs-2 text-success"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Sangria</small>
                            <h4 class="text-danger mt-2 mb-0">
                                @Model.TotalWithdrawal.ToString("C2")
                            </h4>
                        </div>
                        <i class="bi bi-arrow-up-circle fs-2 text-danger"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Despesas</small>
                            <h4 class="text-danger mt-2 mb-0">
                                @Model.TotalExpense.ToString("C2")
                            </h4>
                        </div>
                        <i class="bi bi-arrow-up-circle fs-2 text-danger"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Dinheiro Disponível no caixa</small>
                            <h4 class="mt-2 mb-0 @(Model.Balance >= 0 ? "text-success" : "text-danger")">
                                @Model.Balance.ToString("C2")
                            </h4>
                        </div>

                        <i class="bi bi-wallet2 fs-2 text-success"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Histórico -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                <h5 class="mb-0">
                    Histórico de movimentações
                </h5>

                <form asp-action="Index"
                      method="get"
                      class="d-flex gap-2">

                    <select name="type"
                            class="form-select form-select-sm"
                            onchange="this.form.submit()">

                        <option value="">Todas as movimentações</option>

                        @foreach (CashMovementTypeEnum type in Enum.GetValues(typeof(CashMovementTypeEnum)))
                        {
                            <option value="@type"
                                    selected="@(Context.Request.Query["type"] == type.ToString())">
                                @type
                            </option>
                        }

                    </select>

                </form>

            </div>

        </div>

        <div class="card-body p-0">

            @if (Model.Items.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Data</th>
                                <th>Tipo</th>
                                <th>Descrição</th>
                                <th>Responsável</th>
                                <th class="text-end pe-3">Valor</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model.Items)
                            {
                                var isSupply = item.CashMovementType == CashMovementTypeEnum.Supply;

                                <tr>

                                    <td class="ps-3 text-nowrap">
                                        @item.OccurredAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        @if (item.CashMovementType == CashMovementTypeEnum.Supply)
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                <i class="bi bi-plus-circle me-1"></i>
                                                Suprimento
                                            </span>
                                        }
                                        else if (item.CashMovementType == CashMovementTypeEnum.Withdrawal)
                                        {
                                            <span class="badge bg-danger-subtle text-danger">
                                                <i class="bi bi-dash-circle me-1"></i>
                                                Sangria
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">
                                                <i class="bi bi-receipt me-1"></i>
                                                Despesa
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.Description)
                                            ? "Não informado"
                                            : item.Description)
                                    </td>

                                    <td>
                                        @(item.UserName ?? "Não informado")
                                    </td>

                                    <td class="text-end pe-3 text-nowrap fw-semibold @(isSupply ? "text-success" : "text-danger")">
                                        @(isSupply ? "+" : "-") @item.Amount.ToString("C2")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-inbox display-4 text-muted"></i>

                    <h6 class="mt-3">
                        Nenhuma movimentação encontrada
                    </h6>

                    <p class="text-muted mb-0">
                        Não existem movimentações para os filtros selecionados.
                    </p>

                </div>
            }

        </div>

        <div class="card-footer bg-white text-muted small">
            @Model.TotalRecords movimentação(ões) encontrada(s).
        </div>

    </div>

</div>
