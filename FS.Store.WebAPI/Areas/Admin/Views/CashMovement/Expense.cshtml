@model CashMovementViewModel

@{
    ViewData["Title"] = "Despesas";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">
                <i class="bi bi-cash-stack me-2"></i>
                Despesas (Em dinheiro)
            </h4>
            <p class="text-muted mb-0">
                Registre uma despesa paga em dinheiro retirado do caixa.
            </p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-receipt fs-4 text-danger me-3"></i>
                        <div>
                            <h5 class="mb-0">Dados da despesa</h5>
                            <small class="text-muted">
                                Preencha as informações da despesa.
                            </small>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <!-- Caixa -->
                    <div class="alert alert-danger d-flex align-items-center mb-3">
                        <i class="bi bi-wallet2 fs-5 me-3"></i>
                        <div>
                            <strong>Caixa aberto</strong>
                            <div class="small">
                                @Model.CashSessionNumber
                            </div>
                        </div>
                    </div>

                    <!-- Saldo disponível -->
                    <div class="bg-body-tertiary rounded p-3 mb-4">
                        <small class="text-muted">
                            Saldo disponível em dinheiro
                        </small>
                        <h4 class="mb-0 mt-1">
                            @Model.AvailableBalance.ToString("C2")
                        </h4>
                    </div>

                    <form asp-action="Expense" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="CashSessionId" />
                        <input type="hidden" asp-for="CashSessionNumber" />
                        
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <!-- Valor -->
                        <div class="mb-4">
                            <label asp-for="Amount" class="form-label fw-semibold">
                                Valor da despesa
                            </label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text">R$</span>
                                <input asp-for="Amount" type="text" class="form-control price" inputmode="decimal" placeholder="0,00" autocomplete="off" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <!-- Descrição -->
                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold">
                                Descrição
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="3" maxlength="500" placeholder="Informe o motivo da despesa..." required data-val="true" data-val-required="Informe o motivo da despesa."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                        <hr class="my-4" />
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="bi bi-check-lg me-1"></i>
                                Confirmar despesa
                            </button>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
