@model List<string>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Presentation</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/presentation/public-index.css" asp-append-version="true" />
</head>

<body>

    <div id="presentationCarousel"
         class="carousel slide"
         data-bs-ride="carousel"
         data-bs-interval="5000">

        <div class="carousel-inner">

            @for (var i = 0; i < Model.Count; i++)
            {
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <img src="~/img/presentation/@Model[i]"
                         class="d-block w-100"
                         style="height: 100vh; object-fit: contain;"
                         alt="Presentation image" />
                </div>
            }

        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            document.addEventListener('click', function () {
                if (!document.fullscreenElement) {
                    document.documentElement.requestFullscreen()
                        .catch(function (error) {
                            console.error('Não foi possível entrar em fullscreen:', error);
                        });
                }
            });
    </script>

</body>
</html>